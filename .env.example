# Anthropic AI (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Figma (optional — enables reading exact fonts/colors/spacing for workflow E instead of
# estimating them from a screenshot). Create at figma.com → Settings → Personal access tokens,
# "File content: Read-only" scope is enough.
FIGMA_ACCESS_TOKEN=

# Server port
PORT=3000

# Store credentials: stores.config.json (chỉ cần store URL + themeId, không cần token)
