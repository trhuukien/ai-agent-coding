# FIGMA_ACCESS_TOKEN is always required, in either mode below — it's what lets any Figma design
# get read (fonts/colors/spacing/content) instead of guessed from a screenshot. Create at
# figma.com → Settings → Personal access tokens, "File content: Read-only" scope is enough.
FIGMA_ACCESS_TOKEN=

# This project runs in exactly one of two independent modes — pick one, both aren't needed:
#
# Mode 1 — API key: set ANTHROPIC_API_KEY below, then `npm start` runs the automated server
#   (src/server.js) which builds Figma → Shopify pages on its own via the Projects API/UI, no
#   human in the loop per page.
# Mode 2 — Claude session: leave ANTHROPIC_API_KEY empty, don't run the server at all. Instead
#   open this repo in a Claude Code session and follow CLAUDE.md directly — Claude Code itself
#   performs every step using the scripts/ CLI tools.
ANTHROPIC_API_KEY=

# Server port (Mode 1 only)
PORT=3000

# Store credentials: stores.config.json (chỉ cần store URL + themeId, không cần token)

# Optional — only needed if using scripts/log-to-sheet.js to log Auto-verify FE results to a
# Google Sheet. Path to a Google Cloud Service Account JSON key (Sheets API enabled on that
# project). Share the target Sheet with the service account's own email (Editor) — never make the
# sheet/key public. The key file itself must NEVER be committed (add its filename to .gitignore).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# The single shared tracking spreadsheet Auto-test logs every store's results into (id segment from
# the sheet's URL: docs.google.com/spreadsheets/d/<this-id>/edit). This is NOT a secret and is the
# SAME for every store (unlike storefront passwords, which must never go in this file) — set it once
# and every Auto-test round reuses it automatically instead of asking which spreadsheet to use.
GOOGLE_SHEETS_TRACKING_ID=
