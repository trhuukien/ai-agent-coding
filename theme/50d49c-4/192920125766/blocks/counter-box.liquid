{% liquid
  assign desktop_width = block.settings.desktop_width | times: 1
  assign mobile_width = block.settings.mobile_width | times: 1
%}
{%- capture children_content -%}
  {% content_for 'blocks' %}
{%- endcapture -%}
{%- assign children_content = children_content | strip -%}
{% style %}
  .bg-{{ block.id }} {
    {% if block.settings.border_color_light.alpha != 0.0 %}
      --colors-line-and-border: {{ block.settings.border_color_light.red }}, {{ block.settings.border_color_light.green }}, {{ block.settings.border_color_light.blue }};
    {% endif %}
    {% if block.settings.background_color_light.alpha != 0.0 %}
      --colors-background: {{ block.settings.background_color_light.red }}, {{ block.settings.background_color_light.green }}, {{ block.settings.background_color_light.blue }};
    {%- endif -%}
  }
  .dark .bg-{{ block.id }} {
    {% if block.settings.border_color_dark.alpha != 0.0 %}
      --colors-line-and-border: {{ block.settings.border_color_dark.red }}, {{ block.settings.border_color_dark.green }}, {{ block.settings.border_color_dark.blue }};
    {% else %}
      --colors-line-and-border: {{ settings.colors_dark_line_and_borders.red }}, {{ settings.colors_dark_line_and_borders.green }}, {{ settings.colors_dark_line_and_borders.blue }};
    {% endif %}
    {% if block.settings.background_color_dark.alpha != 0.0 %}
      --colors-background: {{ block.settings.background_color_dark.red }}, {{ block.settings.background_color_dark.green }}, {{ block.settings.background_color_dark.blue }};
    {% else %}
      --colors-background: transparent;
    {% endif %}
  }
  #shopify-block-{{ block.id }}:has(.counter-width-{{ block.id }}) {
    {% if mobile_width < 100 %}
      width: calc({{ mobile_width }}% - 100px);
      flex-grow: 1;
      max-width: {{ mobile_width }}%;
    {% else %}
      width: 100%;
      max-width: 100%;
    {% endif %}
  }
  {% if block.settings.style == 'card' %} 
    #shopify-block-{{ block.id }} .flexible-area-block {
      padding: 0;
      border-width: 0;
    }
  {% endif %}
  @media (max-width: 767px) {
    {% if block.settings.alignment_mobile != 'adapt' %}
      .flexible-area-counter #x-group-{{ block.id }} .flexible-area-block:has(.counter-content-alignment-mobile), .flexible-area-counter #x-group-{{ block.id }}.counter-content-alignment {
        text-align: {{ block.settings.alignment_mobile }};
        {% if block.settings.alignment_mobile == 'center' %}
          margin-left: auto;
          margin-right: auto;
        {% elsif block.settings.alignment_mobile == 'left' %}
        {% else %}
          margin-left: auto;
          margin-right: unset
        {% endif %}
      } 
      #x-group-{{ block.id }} .x-splide-slide {
        display: flex;
        {% if block.settings.alignment_mobile == 'center' %}
          justify-content: center;
        {% elsif block.settings.alignment_mobile == 'left' %}
          justify-content: flex-start;
        {% elsif block.settings.alignment_mobile == 'right' %}
          justify-content: flex-end;
        {% else %}
        {% endif %}
      }       
    {% endif %}
    {% if block.settings.position_mobile != 'adapt' %}
      #x-group-{{ block.id }} .x-splide-slide {
        align-items: {{ block.settings.position_mobile }};
      }
    {% endif %}
  }
  @media (min-width: 768px) {
    #shopify-block-{{ block.id }}:has(.counter-width-{{ block.id }}) {
      {% if desktop_width < 100 %}
        width: calc({{ desktop_width }}% - 100px);
        flex-grow: 1;
        max-width: {{ desktop_width }}%;
      {% else %}
        width: 100%;
        max-width: 100%;
      {% endif %}
    }
    {% if block.settings.alignment_desktop != 'adapt' %}
      .flexible-area-counter #x-group-{{ block.id }} .flexible-area-block:has(.counter-content-alignment), .flexible-area-counter #x-group-{{ block.id }}.counter-content-alignment {
        text-align: {{ block.settings.alignment_desktop }};
        {% if block.settings.alignment_desktop == 'center' %}
          margin-left: auto;
          margin-right: auto;
        {% elsif block.settings.alignment_desktop == 'left' %}
        {% else %}
          margin-left: auto;
          margin-right: unset
        {% endif %}
      }
      #x-group-{{ block.id }} .x-splide-slide {
        display: flex;
        {% if block.settings.alignment_desktop == 'center' %}
          justify-content: center;
        {% elsif block.settings.alignment_desktop == 'left' %}
          justify-content: flex-start;
        {% else %}
          justify-content: flex-end;
        {% endif %}
      }      
    {% endif %}
    {% if block.settings.position != 'adapt' %}
      #x-group-{{ block.id }} .x-splide-slide {
        align-items: {{ block.settings.position }};
      }
    {% endif %}
  }
{% endstyle %}
<div
  id="x-group-{{ block.id }}"
  data-width="{{ desktop_width }}" 
  data-width-mobile="{{ mobile_width }}" 
  class="x-theme-block-group counter-block-{{ block.id }} {% if block.settings.style == "card" %} override-border-item-group{% endif %} item-block {% if block.settings.alignment_mobile == 'adapt' %}item-group-content-alignment-mobile{% endif %} {% if block.settings.alignment_desktop == 'adapt' %}item-group-content-alignment{% endif %} counter-content-alignment relative z-0 flex flex-wrap w-full h-full content-{{ block.settings.position_mobile }} md:content-{{ block.settings.position }} counter-width-{{ block.id }} {% if block.settings.style == "card" and children_content != blank %} bg-{{ block.id }} md:pt-10 md:pb-10 md:pl-8 md:pr-8 pt-7.5 pb-7.5 pl-4 pr-4{% endif %} {% if block.settings.style == "card" %} border-{{ block.settings.border_style }} border-{{ block.settings.border_width }} bg-[rgba(var(--colors-background))]{% endif %}{% if block.settings.border_radius == "rounded" %} rounded-[10px]{% endif %}"
  x-data="xFlexibleArea" 
  x-init="$nextTick(() => { initArea($el) });"
>
  {{ children_content }}
</div>
{% schema %}
{
  "name": "t:sections.flexible-area.blocks.counter.name",
  "class": "flexible-area-counter flexible-area-block splide__slide x-splide-slide",
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "rich-text"
    },
    {
      "type": "_counter-number"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "t:sections.flexible-area.blocks.item-group.settings.desktop_width",
      "options": [
        {
          "label": "25%",
          "value": "25"
        },
        {
          "label": "50%",
          "value": "50"
        },
        {
          "label": "100%",
          "value": "100"
        }
      ],
      "default": "25"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:sections.all.content_position.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.content_position.options__11.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-comparison.settings.heading_image_position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.content_position.options__12.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.flexible-area.blocks.item-group.settings.adapt_item_group_alignment"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "alignment_desktop",
      "label": "t:sections.all.alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.flexible-area.blocks.item-group.settings.adapt_item_group_alignment"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_layout_mobile"
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "t:sections.flexible-area.blocks.item-group.settings.mobile_width",
      "options": [
        {
          "label": "50%",
          "value": "50"
        },
        {
          "label": "100%",
          "value": "100"
        }
      ],
      "default": "50"
    },
    {
      "type": "select",
      "id": "position_mobile",
      "label": "t:sections.all.content_position.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.content_position.options__11.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-comparison.settings.heading_image_position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.content_position.options__12.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.flexible-area.blocks.item-group.settings.adapt_item_group_alignment"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "t:sections.all.alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.flexible-area.blocks.item-group.settings.adapt_item_group_alignment"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "header",
      "content": "t:sections.flexible-area.blocks.counter.appearance"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.all.header.style",
      "options": [
        {
          "value": "standard",
          "label": "t:sections.flexible-area.blocks.counter.standard"
        },
        {
          "value": "card",
          "label": "t:sections.flexible-area.blocks.counter.card"
        }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:sections.flexible-area.blocks.counter.border_style.name",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.icon.options.none"
        },
        {
          "value": "solid",
          "label": "t:sections.flexible-area.blocks.counter.border_style.solid"
        },
        {
          "value": "dashed",
          "label": "t:sections.flexible-area.blocks.counter.border_style.dashed"
        },
        {
          "value": "dotted",
          "label": "t:sections.flash-sale.settings.section_border.dotted"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.style == 'card' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:sections.flexible-area.blocks.counter.border_width",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style != 'none' and block.settings.style == 'card' }}"
    },    
    {
      "type": "select",
      "id": "border_radius",
      "label": "t:sections.flexible-area.blocks.counter.border_radius",
      "options": [
        {
          "value": "square",
          "label": "t:settings_schema.products.square"
        },
        {
          "value": "rounded",
          "label": "t:settings_schema.buttons.rounded"
        }
      ],
      "default": "square",
      "visible_if": "{{ block.settings.style == 'card' }}"
    },
    {
      "type": "color",
      "id": "border_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.product-labels-and-badges.blocks.border_color.label",
      "visible_if": "{{ block.settings.border_style != 'none' and block.settings.style == 'card' }}"
    },
    {
      "type": "color",
      "id": "border_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.product-labels-and-badges.blocks.border_color_dark.label",
      "visible_if": "{{ block.settings.border_style != 'none' and block.settings.style == 'card' }}"
    },
    {
      "type": "color",
      "id": "background_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.background.background_color_light",
      "visible_if": "{{ block.settings.style == 'card' }}"
    },
    {
      "type": "color",
      "id": "background_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.background.background_color_dark",
      "visible_if": "{{ block.settings.style == 'card' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.flexible-area.blocks.counter.name",
      "category": "t:sections.promotion-grid.blocks.promotion.settings.header.content"
    }
  ]
}
{% endschema %}