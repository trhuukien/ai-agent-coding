{%- if section.settings.cookie_enabled -%}
  {%- style -%}
    {% unless section.settings.text_color_cookie_light.alpha == 0.0 %}
      .color-heading--{{ section.id }} {
        --colors-heading: {{ section.settings.text_color_cookie_light.red }}, {{ section.settings.text_color_cookie_light.green }}, {{ section.settings.text_color_cookie_light.blue }};
      }
    {% endunless %}
    .dark .color-heading--{{ section.id }} {
      {% unless section.settings.text_color_cookie_dark.alpha == 0.0 %}
        --colors-heading: {{ section.settings.text_color_cookie_dark.red }}, {{ section.settings.text_color_cookie_dark.green }}, {{ section.settings.text_color_cookie_dark.blue }};
      {% else %}
        --colors-heading: {{ settings.colors_dark_heading.red }}, {{ settings.colors_dark_heading.green }}, {{ settings.colors_dark_heading.blue }};
      {% endunless %}
    }
    .button-accept {
      {% if section.settings.accept_button_text.alpha == 0.0 %}
        color: rgba(var(--colors-button-text-hover));
      {% else %}
        color: {{ section.settings.accept_button_text }};
      {% endif %}
      {% if section.settings.accept_button_background.alpha == 0.0 %}
        background-color: var(--colors-button-hover);
        border-color: var(--colors-button-hover);
      {% else %}
        background-color: {{ section.settings.accept_button_background }};
        border-color: {{ section.settings.accept_button_background }};
      {% endif %}
    }
    .dark .button-accept {
      {% if section.settings.accept_button_text_dark.alpha == 0.0 %}
        color: rgba(var(--colors-button-text-hover));
      {% else %}
        color: {{ section.settings.accept_button_text_dark }};
      {% endif %}
      {% if section.settings.accept_button_background_dark.alpha == 0.0 %}
        background-color: var(--colors-button-hover);
        border-color: var(--colors-button-hover);
      {% else %}
        background-color: {{ section.settings.accept_button_background_dark }};
        border-color: {{ section.settings.accept_button_background_dark }};
      {% endif %}
    }
    .button-decline {
      {% if section.settings.text_color_cookie_light.alpha == 0.0 %}
        border-color: rgba(var(--colors-text));
        color: rgba(var(--colors-text));
      {% else %}
        border-color: {{ section.settings.text_color_cookie_light }};
        color: {{ section.settings.text_color_cookie_light }};
      {% endif %}
      border: 1px solid;
    }
    .dark .button-decline {
      {% if section.settings.text_color_cookie_dark.alpha == 0.0 %}
        border-color: rgba(var(--colors-text));
        color: rgba(var(--colors-text));
      {% else %}
        border-color: {{ section.settings.text_color_cookie_dark }};
        color: {{ section.settings.text_color_cookie_dark }};
      {% endif %}
      border: 1px solid;
    }
    .bg-cookie-banner {
      {% if section.settings.text_color_cookie_light.alpha == 0.0 %}
        color: rgba(var(--colors-text));
      {% else %}
        color: {{ section.settings.text_color_cookie_light }};
      {% endif %}
      background: {{ section.settings.background_color_cookie_light }};
    }
    .dark .bg-cookie-banner {
      {% if section.settings.text_color_cookie_dark.alpha == 0.0 %}
        color: rgba(var(--colors-text));
      {% else %}
        color: {{ section.settings.text_color_cookie_dark }};
      {% endif %}
      background: {{ section.settings.background_color_cookie_dark }};
    }
    .cookie-toggle-slider {
      background-color: rgba({{ section.settings.text_color_cookie_light.red }},{{ section.settings.text_color_cookie_light.green }},{{ section.settings.text_color_cookie_light.blue }}, 0.3);
      transition: 0.25s;
      border-radius: 22px;
    }
    .dark .cookie-toggle-slider {
      background-color: rgba({{ section.settings.text_color_cookie_dark.red }},{{ section.settings.text_color_cookie_dark.green }},{{ section.settings.text_color_cookie_dark.blue }}, 0.3);
    }
    .cookie-toggle-slider:before {
      position: absolute;
      content: "";
      height: 16px;
      width: 16px;
      left: 3px;
      bottom: 3px;
      background-color: {{ section.settings.background_color_cookie_light }};
      transition: 0.25s;
      border-radius: 50%;
    }
    .dark .cookie-toggle-slider:before {
      background-color: {{ section.settings.background_color_cookie_dark }};
    }
    .cookie-toggle input:checked + .cookie-toggle-slider {
      background-color: rgba({{ section.settings.text_color_cookie_light.red }},{{ section.settings.text_color_cookie_light.green }},{{ section.settings.text_color_cookie_light.blue }}, 1);
    }
    .dark .cookie-toggle input:checked + .cookie-toggle-slider {
      background-color: rgba({{ section.settings.text_color_cookie_dark.red }},{{ section.settings.text_color_cookie_dark.green }},{{ section.settings.text_color_cookie_dark.blue }}, 1);
    }
    .cookie-toggle input:checked + .cookie-toggle-slider:before {
      transform: translateX(18px);
    }
    .cookie-toggle input:disabled + .cookie-toggle-slider {
      cursor: not-allowed;
      opacity: 0.5;
    }
    .cookie-pref-panel {
      background: {{ section.settings.background_color_cookie_light }};
      max-height: 80vh;
    }
    .dark .cookie-pref-panel {
      background: {{ section.settings.background_color_cookie_dark }};
    }
  {%- endstyle -%}
  <div 
    id="cookies-banner" 
    x-data="xCookieBanner({{ section.settings.cookie_delay }})" {% if request.design_mode %} 
    x-show="$store.xShowCookieBanner.show" {% else %} x-show="show" {% endif %} 
    x-cloak 
    x-transition:enter="transition-all ease-in-out duration-500"
    x-transition:enter-start="opacity-0 transform translate-y-full"
    x-transition:enter-end="opacity-100 transform translate-y-0"
    x-transition:leave="transition-all ease-in-out duration-500"
    x-transition:leave-end="opacity-0 transform translate-y-full"
    class="w-full fixed bottom-0 left-0 right-0 z-50 bg-cookie-banner color-heading--{{ section.id }}"
  >
    <div class="x-pgw page-width mr-auto ml-auto flex flex-wrap lg:flex-nowrap lg:justify-between">
      <div class="rte x-block-cookie-content pt-3 pb-3 w-full lg:pt-4 lg:pb-4 lg:w-auto md:flex md:flex-col md:items-start
        {%- if section.settings.content_alignment == '' %} md:justify-start rtl:md:justify-end text-left rtl:text-right{% endif -%}
        {%- if section.settings.content_alignment == 'right' %} md:justify-end rtl:md:justify-start text-right rtl:text-left{% endif -%}
        {%- if section.settings.content_alignment == 'center' %} md:justify-center text-center{% endif %}"
      >
        <span>{{ section.settings.cookie_notice }}</span>
        {%- if section.settings.enable_manage_preferences -%}
          <button class="underline inline-block text-left cursor-pointer" @click="handleManagePreferences()">
            {{ 'sections.cookie_banner.manage_preferences' | t }}
          </button>
        {%- endif -%}
      </div>
      <div class="flex items-center pb-3 lg:pb-0 lg:ml-7 rtl:lg:ml-0 rtl:lg:mr-7 justify-center md:justify-start gap-2 w-full md:w-auto">
        {% if section.settings.button_decline != blank %}
          <button class="button w-auto button-decline pl-10 pr-10 pt-4 pb-4 lg:mt-4 lg:mb-4 empty:hidden whitespace-nowrap" @click="handleDecline()">
            {{ section.settings.button_decline | escape }}
          </button>
        {% endif %}
        {% if section.settings.button_accept != blank %}
          <button class="button button-accept w-auto pl-10 pr-10 pt-4 pb-4 mr-2.5 lg:mt-4 lg:mb-4 empty:hidden whitespace-nowrap" @click="handleAccept()">
            {{ section.settings.button_accept | escape }}
          </button>
        {% endif %}
      </div>
    </div>

    {%- if section.settings.enable_manage_preferences -%}
      <div
        x-show="showPreferencesPopup"
        x-cloak
        x-transition.opacity
        @keydown.escape.window="closePreferences()"
        class="x-cookie-pref-backdrop fixed inset-0 z-[60] flex items-center justify-center"
      >
        {% if settings.show_popup_overlay %}<div class="x-overlay absolute top-0 left-0 right-0 bottom-0 bg-[#acacac] bg-opacity-30"></div>{% endif %}
        <div
          x-show="showPreferencesPopup"
          x-transition.opacity
          class="z-10 mr-5 ml-5"
          @click.away="closePreferences()"
        >
          <div
            class="cookie-pref-panel color-heading--{{ section.id }} pl-7 pr-7 pb-7 pt-7 rounded-lg shadow-md lg:max-w-[700px] w-full overflow-hidden flex flex-col"
            @click.stop
          >
            <div class="pb-4">
              <h2 class="mb-2">{{ 'sections.cookie_banner.popup_heading' | t }}</h2>
              <p class="">{{ 'sections.cookie_banner.popup_description' | t }}</p>
            </div>

            <div class="overflow-y-auto scrollbar-body flex-1">
              <div x-data="{ open: true }" class="border-b pt-4 pb-4">
                <div class="flex items-start gap-3">
                  <div @click="open = !open" class="cursor-pointer flex-shrink-0">
                    <span :class="open ? 'rotate-180' : ''" class="w-3 h-3 inline-block transition-transform duration-300">
                      {% render 'icon-alls', icon: 'icon-caret' %}
                    </span>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between">
                      <strong @click="open = !open" class="cursor-pointer font-semibold">{{ 'sections.cookie_banner.option_required.label' | t }}</strong>
                      <span class="text-[80%] uppercase tracking-wider opacity-70">{{ 'sections.cookie_banner.always_on' | t }}</span>
                    </div>
                    <p x-show="open" x-collapse class="mt-2">{{ 'sections.cookie_banner.option_required.info' | t }}</p>
                  </div>
                </div>
              </div>

              <div x-data="{ open: false }" class="border-b pt-4 pb-4">
                <div class="flex items-start gap-3">
                  <div @click="open = !open" class="cursor-pointer flex-shrink-0">
                    <span :class="open ? 'rotate-180' : ''" class="w-3 h-3 inline-block transition-transform duration-300">
                      {% render 'icon-alls', icon: 'icon-caret' %}
                    </span>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between gap-3">
                      <strong @click="open = !open" class="cursor-pointer font-semibold">{{ 'sections.cookie_banner.option_personalization.label' | t }}</strong>
                      <label class="cookie-toggle relative inline-block w-10 h-5.5 shrink-0">
                        <input class="opacity-0 w-0 h-0" type="checkbox" x-model="prefs.preferences">
                        <span class="cookie-toggle-slider absolute cursor-pointer top-0 left-0 right-0 bottom-0"></span>
                      </label>
                    </div>
                    <p x-show="open" x-collapse class="mt-2">{{ 'sections.cookie_banner.option_personalization.info' | t }}</p>
                  </div>
                </div>
              </div>

              <div x-data="{ open: false }" class="border-b pt-4 pb-4">
                <div class="flex items-start gap-3">
                  <div @click="open = !open" class="cursor-pointer flex-shrink-0">
                    <span :class="open ? 'rotate-180' : ''" class="w-3 h-3 inline-block transition-transform duration-300">
                      {% render 'icon-alls', icon: 'icon-caret' %}
                    </span>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between gap-3">
                      <strong @click="open = !open" class="cursor-pointer font-semibold">{{ 'sections.cookie_banner.option_marketing.label' | t }}</strong>
                      <label class="cookie-toggle relative inline-block w-10 h-5.5 shrink-0">
                        <input class="opacity-0 w-0 h-0" type="checkbox" x-model="prefs.marketing">
                        <span class="cookie-toggle-slider absolute cursor-pointer top-0 left-0 right-0 bottom-0"></span>
                      </label>
                    </div>
                    <p x-show="open" x-collapse class="mt-2">{{ 'sections.cookie_banner.option_marketing.info' | t }}</p>
                  </div>
                </div>
              </div>

              <div x-data="{ open: false }" class="border-b pt-4 pb-4">
                <div class="flex items-start gap-3">
                  <div @click="open = !open" class="cursor-pointer flex-shrink-0">
                    <span :class="open ? 'rotate-180' : ''" class="w-3 h-3 inline-block transition-transform duration-300">
                      {% render 'icon-alls', icon: 'icon-caret' %}
                    </span>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between gap-3">
                      <strong @click="open = !open" class="cursor-pointer font-semibold">{{ 'sections.cookie_banner.option_analytics.label' | t }}</strong>
                      <label class="cookie-toggle relative inline-block w-10 h-5.5 shrink-0">
                        <input class="opacity-0 w-0 h-0" type="checkbox" x-model="prefs.analytics">
                        <span class="cookie-toggle-slider absolute cursor-pointer top-0 left-0 right-0 bottom-0"></span>
                      </label>
                    </div>
                    <p x-show="open" x-collapse class="mt-2">{{ 'sections.cookie_banner.option_analytics.info' | t }}</p>
                  </div>
                </div>
              </div>

              <div x-data="{ open: false }" x-show="saleOfDataRegion" x-cloak class="pt-4 pb-4 border-b">
                <div class="flex items-start gap-3">
                  <div @click="open = !open" class="cursor-pointer flex-shrink-0">
                    <span :class="open ? 'rotate-180' : ''" class="w-3 h-3 inline-block transition-transform duration-300">
                      {% render 'icon-alls', icon: 'icon-caret' %}
                    </span>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between gap-3">
                      <strong @click="open = !open" class="cursor-pointer font-semibold">{{ 'sections.cookie_banner.option_sale_of_data.label' | t }}</strong>
                      <label class="cookie-toggle relative inline-block w-10 h-5.5 shrink-0">
                        <input class="opacity-0 w-0 h-0" type="checkbox" x-model="prefs.sale_of_data">
                        <span class="cookie-toggle-slider absolute cursor-pointer top-0 left-0 right-0 bottom-0"></span>
                      </label>
                    </div>
                    <p x-show="open" x-collapse class="mt-2">{{ 'sections.cookie_banner.option_sale_of_data.info' | t }}</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="flex justify-end gap-2 p-6 pt-4">
              <button type="button" class="button w-auto button-decline pl-6 pr-6 pt-3 pb-3 whitespace-nowrap" @click="handleDeclineAll()">
                {{ 'sections.cookie_banner.decline_all' | t }}
              </button>
              <button type="button" class="button button-accept w-auto pl-6 pr-6 pt-3 pb-3 whitespace-nowrap" @click="handleSaveChoices()">
                {{ 'sections.cookie_banner.save_choices' | t }}
              </button>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
<script src="{{ 'cookie-banner.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:settings_schema.cookie_banner.name",
  "class": "section-cookie-banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.user_guide_link.overlay_group.cookie_banner"
    },
    {
      "type": "paragraph",
      "content": "t:settings_schema.cookie_banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "cookie_enabled",
      "label": "t:settings_schema.shipping_delivery.free_shipping.enable.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_manage_preferences",
      "label": "t:settings_schema.cookie_banner.settings.enable_manage_preferences.label",
      "default": false
    },
    {
      "type": "richtext",
      "id": "cookie_notice",
      "default": "<p>We use cookies and similar technologies to provide the best experience on our website.</p>",
      "label": "t:settings_schema.cookie_banner.settings.notice.label"
    },
    {
      "type": "range",
      "id": "cookie_delay",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "t:settings_schema.cookie_banner.settings.delay.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.all.content_alignment.label",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "t:settings_schema.cookie_banner.settings.header_cookie_style.content"
    },
    {
      "type": "text",
      "id": "button_accept",
      "default": "Got it!",
      "label": "t:settings_schema.cookie_banner.settings.button_accept.label"
    },
    {
      "type": "text",
      "id": "button_decline",
      "default": "Decline",
      "label": "t:settings_schema.cookie_banner.settings.button_decline.label"
    },
    {
      "type": "color",
      "id": "background_color_cookie_light",
      "default": "#000000",
      "label": "t:sections.all.background.background_color_light"
    },
    {
      "type": "color",
      "id": "text_color_cookie_light",
      "default": "#999999",
      "label": "t:sections.all.text.color"
    },
    {
      "type": "color",
      "id": "accept_button_background",
      "default": "#FB8500",
      "label": "t:settings_schema.cookie_banner.settings.accept_button_background.label"
    },
    {
      "type": "color",
      "id": "accept_button_text",
      "default": "#000000",
      "label": "t:settings_schema.cookie_banner.settings.accept_button_text.label"
    },
    {
      "type": "color",
      "id": "background_color_cookie_dark",
      "default": "#FFFFFF",
      "label": "t:sections.all.background.background_color_dark"
    },
    {
      "type": "color",
      "id": "text_color_cookie_dark",
      "default": "#525151",
      "label": "t:sections.all.text.color_dark"
    },
    {
      "type": "color",
      "id": "accept_button_background_dark",
      "default": "#FB8500",
      "label": "t:settings_schema.cookie_banner.settings.accept_button_background_dark.label"
    },
    {
      "type": "color",
      "id": "accept_button_text_dark",
      "default": "#000000",
      "label": "t:settings_schema.cookie_banner.settings.accept_button_text_dark.label"
    }
  ]
}
{% endschema %}