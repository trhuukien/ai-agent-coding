{%- liquid
  assign heading_size = section.settings.heading_size | times: settings.heading_base_size | times: 0.000225
  assign answer_heading_size = section.settings.answer_heading_size | times: settings.heading_base_size | times: 0.000225

  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
  else
    assign is_rtl = false
  endif

  assign text_alignment = section.settings.text_alignment
  if text_alignment == 'left'
    assign rtl_alignment = 'right'
  elsif text_alignment == 'right'
    assign rtl_alignment = 'left'
  else
    assign rtl_alignment = 'center'
  endif

  assign answer_text_alignment = section.settings.answer_text_alignment
  if answer_text_alignment == 'left'
    assign answer_rtl_alignment = 'right'
  elsif answer_text_alignment == 'right'
    assign answer_rtl_alignment = 'left'
  else
    assign answer_rtl_alignment = 'center'
  endif

  assign default_recommended_product_ids = ''
  if section.settings.default_recommended_product != blank
    assign default_recommended_product_list = section.settings.default_recommended_product | where: 'available'
    for product in default_recommended_product_list
      if settings.gift_wrapping_product != blank and settings.hide_gift_wrapping and settings.gift_wrapping_product.id == product.id
        continue
      endif
      if settings.engraving_product != blank and settings.engraving_product.id == product.id
        continue
      endif
      if settings.product_shipping_insurance != blank and settings.product_shipping_insurance.id == product.id
        continue
      endif

      assign default_recommended_product_ids = default_recommended_product_ids | append: product.id | append: ','
    endfor
    assign default_recommended_product_ids = default_recommended_product_ids | remove_last: ','
  endif

  assign ratio = 100
  case settings.product_image_ratio
    when 'portrait'
      assign ratio = 150
    when 'landscape'
      assign ratio = 75
    when 'wide'
      assign ratio = 56.25
    when '3/4'
      assign ratio = 133
  endcase

  if settings.enable_lazy_loading_image
    assign loading = 'lazy'
  else
    assign loading = 'eager'
  endif

  if section.settings.add_all_button_label != blank
    assign has_add_all = true
  else
    assign has_add_all = false
  endif
-%}
{%- style -%}
  @keyframes loadingAnswer {
    0%, 100% {
      opacity: 0;
    }
    50% {
      opacity: .3;
    }
  }
  .anim-answer-loading {
    animation: loadingAnswer 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  .section-padding-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 768px) {
    .section-padding-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .section-quiz-{{ section.id }} {
    {% if section.settings.background_color_light.alpha != 0.0 %}
      --colors-background: {{ section.settings.background_color_light.red }},{{ section.settings.background_color_light.green }},{{ section.settings.background_color_light.blue }};
    {% else %}
      --colors-background: {{ settings.colors_background.red }},{{ settings.colors_background.green }},{{ settings.colors_background.blue }};
    {% endif %}
  }
  .dark .section-quiz-{{ section.id }} {
    {% if section.settings.background_color_dark.alpha != 0.0 %}
      --colors-background: {{ section.settings.background_color_dark.red }},{{ section.settings.background_color_dark.green }},{{ section.settings.background_color_dark.blue }};
    {% else %}
      --colors-background: {{ settings.colors_dark_background.red }},{{ settings.colors_dark_background.green }},{{ settings.colors_dark_background.blue }};
    {% endif %}
  }
  .heading-{{ section.id }} {
    font-size: {{ heading_size | times: 0.6 }}rem;
    {% if section.settings.heading_color_light.alpha != 0.0 %}
      --colors-heading: {{ section.settings.heading_color_light.red }},{{ section.settings.heading_color_light.green }},{{ section.settings.heading_color_light.blue }};
    {% else %}
      --colors-heading: {{ settings.colors_heading.red }},{{ settings.colors_heading.green }},{{ settings.colors_heading.blue }};
    {% endif %}
  }
  .dark .heading-{{ section.id }} {
    {% if section.settings.heading_color_dark.alpha != 0.0 %}
      --colors-heading: {{ section.settings.heading_color_dark.red }},{{ section.settings.heading_color_dark.green }},{{ section.settings.heading_color_dark.blue }};
    {% else %}
      --colors-heading: {{ settings.colors_dark_heading.red }},{{ settings.colors_dark_heading.green }},{{ settings.colors_dark_heading.blue }};
    {% endif %}
  }
  @media screen and (min-width: 768px) {
    .heading-{{ section.id }} { font-size: {{ heading_size }}rem; }
  }
  .heading-answer-{{ section.id }} {
    font-size: {{ answer_heading_size | times: 0.6 }}rem;
  }
  @media screen and (min-width: 768px) {
    .heading-answer-{{ section.id }} { font-size: {{ answer_heading_size }}rem; }
  }
  .subheading-color--{{ section.id }} {
    {% if section.settings.subheading_color_light.alpha != 0.0 %}
      color: rgb({{ section.settings.subheading_color_light.red }},{{ section.settings.subheading_color_light.green }},{{ section.settings.subheading_color_light.blue }});
    {% else %}
      color: rgb(var(--colors-text));
    {% endif %}
  }
  .dark .subheading-color--{{ section.id }} {
    {% if section.settings.subheading_color_dark.alpha != 0.0 %}
      color: rgb({{ section.settings.subheading_color_dark.red }},{{ section.settings.subheading_color_dark.green }},{{ section.settings.subheading_color_dark.blue }});
    {% else %}
      color: rgb(var(--colors-text));
    {% endif %}
  }
  .text-color--{{ section.id }} {
    {% if section.settings.text_color_light.alpha != 0.0 %}
      color: rgb({{ section.settings.text_color_light.red }},{{ section.settings.text_color_light.green }},{{ section.settings.text_color_light.blue }});
    {% else %}
      color: rgb(var(--colors-text));
    {% endif %}
  }
  .dark .text-color--{{ section.id }} {
    {% if section.settings.text_color_dark.alpha != 0.0 %}
      color: rgb({{ section.settings.text_color_dark.red }},{{ section.settings.text_color_dark.green }},{{ section.settings.text_color_dark.blue }});
    {% else %}
      color: rgb(var(--colors-text));
    {% endif %}
  }
  .button-quiz-{{ section.id }}, .button-quiz-{{ section.id }} *:before {
    {% if section.settings.button_light.alpha != 0.0 %}
      --colors-button: {{ section.settings.button_light.red }},{{ section.settings.button_light.green }},{{ section.settings.button_light.blue }};
    {% endif %}
    {% if section.settings.button_text_light.alpha != 0.0 %}
      --colors-button-text: {{ section.settings.button_text_light.red }},{{ section.settings.button_text_light.green }},{{ section.settings.button_text_light.blue }};
    {% endif %}
    {% if section.settings.button_hover_light.alpha != 0.0 %}
      --colors-button-hover: rgb({{ section.settings.button_hover_light.red }},{{ section.settings.button_hover_light.green }},{{ section.settings.button_hover_light.blue }});
    {% endif %}
    {% if section.settings.button_text_hover_light.alpha != 0.0 %}
      --colors-button-text-hover: {{ section.settings.button_text_hover_light.red }},{{ section.settings.button_text_hover_light.green }},{{ section.settings.button_text_hover_light.blue }};
    {% endif %}
    {% if section.settings.secondary_button_text_light.alpha != 0.0 %}
      --colors-secondary-button: {{ section.settings.secondary_button_text_light.red }}, {{ section.settings.secondary_button_text_light.green }}, {{ section.settings.secondary_button_text_light.blue }};
      --colors-line-secondary-button: {{ section.settings.secondary_button_text_light.red }}, {{ section.settings.secondary_button_text_light.green }}, {{ section.settings.secondary_button_text_light.blue }};
      --background-secondary-button: transparent;
    {% endif %}
    {% if section.settings.secondary_button_light.alpha != 0.0 %}
      --background-secondary-button: {{ section.settings.secondary_button_light.red }}, {{ section.settings.secondary_button_light.green }}, {{ section.settings.secondary_button_light.blue }};
      --colors-line-secondary-button: {{ section.settings.secondary_button_light.red }}, {{ section.settings.secondary_button_light.green }}, {{ section.settings.secondary_button_light.blue }};
    {% endif %}
  }
  .dark .button-quiz-{{ section.id }}, .dark .button-quiz-{{ section.id }} *:before {
    {% if section.settings.button_dark.alpha != 0.0 %}
      --colors-button: {{ section.settings.button_dark.red }},{{ section.settings.button_dark.green }},{{ section.settings.button_dark.blue }};
    {% else %}
      --colors-button: {{ settings.colors_dark_button.red }},{{ settings.colors_dark_button.green }},{{ settings.colors_dark_button.blue }};
    {% endif %}
    {% if section.settings.button_text_dark.alpha != 0.0 %}
      --colors-button-text: {{ section.settings.button_text_dark.red }},{{ section.settings.button_text_dark.green }},{{ section.settings.button_text_dark.blue }};
    {% else %}
      --colors-button-text: {{ settings.colors_dark_button_text.red }},{{ settings.colors_dark_button_text.green }},{{ settings.colors_dark_button_text.blue }};
    {% endif %}
    {% if section.settings.button_hover_dark.alpha != 0.0 %}
      --colors-button-hover: rgb({{ section.settings.button_hover_dark.red }},{{ section.settings.button_hover_dark.green }},{{ section.settings.button_hover_dark.blue }});
    {% else %}
      --colors-button-hover: rgb({{ settings.colors_dark_button_hover.red }},{{ settings.colors_dark_button_hover.green }},{{ settings.colors_dark_button_hover.blue }});
    {% endif %}
    {% if section.settings.button_text_hover_dark.alpha != 0.0 %}
      --colors-button-text-hover: {{ section.settings.button_text_hover_dark.red }},{{ section.settings.button_text_hover_dark.green }},{{ section.settings.button_text_hover_dark.blue }};
    {% else %}
      --colors-button-text-hover: {{ settings.colors_dark_button_text_hover.red }},{{ settings.colors_dark_button_text_hover.green }},{{ settings.colors_dark_button_text_hover.blue }};
    {% endif %}
    {% if section.settings.secondary_button_text_dark.alpha != 0.0 %}
      --colors-secondary-button: {{ section.settings.secondary_button_text_dark.red }}, {{ section.settings.secondary_button_text_dark.green }}, {{ section.settings.secondary_button_text_dark.blue }};
      --colors-line-secondary-button: {{ section.settings.secondary_button_text_dark.red }}, {{ section.settings.secondary_button_text_dark.green }}, {{ section.settings.secondary_button_text_dark.blue }};
      --background-secondary-button: transparent;
    {% else %}  
      --colors-secondary-button: {{ settings.colors_dark_button_secondary.red }}, {{ settings.colors_dark_button_secondary.green }}, {{ settings.colors_dark_button_secondary.blue }};
      --colors-line-secondary-button: {{ settings.colors_dark_button_secondary.red }}, {{ settings.colors_dark_button_secondary.green }}, {{ settings.colors_dark_button_secondary.blue }};
    {% endif %}
    {% if section.settings.secondary_button_dark.alpha != 0.0 %}
      --background-secondary-button: {{ section.settings.secondary_button_dark.red }}, {{ section.settings.secondary_button_dark.green }}, {{ section.settings.secondary_button_dark.blue }};
      --colors-line-secondary-button: {{ section.settings.secondary_button_dark.red }}, {{ section.settings.secondary_button_dark.green }}, {{ section.settings.secondary_button_dark.blue }};
    {% elsif settings.background_dark_button_secondary.alpha != 0.0 %}  
      --background-secondary-button: {{ settings.background_dark_button_secondary.red }}, {{ settings.background_dark_button_secondary.green }}, {{ settings.background_dark_button_secondary.blue }};
      --colors-line-secondary-button: {{ settings.background_dark_button_secondary.red }}, {{ settings.background_dark_button_secondary.green }}, {{ settings.background_dark_button_secondary.blue }};
    {% else %}
      --background-secondary-button: transparent;
    {% endif %}
  }
  .section-quiz-{{ section.id }}.active {
    height: {{ section.settings.mobile_height }};
  }
  #x-quiz-questions-container-{{ section.id }}, .quiz-intro-height-{{ section.id }} {
    height: 100%;
  }
  @media (min-width: 768px) {
    .section-quiz-{{ section.id }}.active {
      height: {{ section.settings.desktop_height }};
    }
    #x-quiz-questions-container-{{ section.id }}, .quiz-intro-height-{{ section.id }} {
      height: 100%;
    }
  }
  .quiz-pagination-{{ section.id }} {
    --pagination-width: 0;
    {% if section.settings.progress_bar_color_light.alpha != 0.0 %}
      background: rgba({{ section.settings.progress_bar_color_light.red }}, {{ section.settings.progress_bar_color_light.green }}, {{ section.settings.progress_bar_color_light.blue }}, 0.2);
    {% else %}
      --color-highlight: {{ settings.colors_heading_highlight.red }}, {{ settings.colors_heading_highlight.green }}, {{ settings.colors_heading_highlight.blue }};
      background: rgba(var(--color-highlight), 0.2);
    {% endif %}
  }
  .dark .quiz-pagination-{{ section.id }} {
    {% if section.settings.progress_bar_color_dark.alpha != 0.0 %}
      background: rgba({{ section.settings.progress_bar_color_dark.red }}, {{ section.settings.progress_bar_color_dark.green }}, {{ section.settings.progress_bar_color_dark.blue }}, 0.2);
    {% else %}
      --color-highlight: {{ settings.colors_dark_heading_highlight.red }}, {{ settings.colors_dark_heading_highlight.green }}, {{ settings.colors_dark_heading_highlight.blue }};
      background: rgba(var(--color-highlight), 0.2);
    {% endif %}
  }
  .quiz-pagination-{{ section.id }}::after {
    top: 0;
    {% if is_rtl %}
      right: 0;
    {% else %}
      left: 0;
    {% endif %}
    padding-top: 8px;
    {% if section.settings.progress_bar_color_light.alpha != 0.0 %}
      background: rgba({{ section.settings.progress_bar_color_light.red }}, {{ section.settings.progress_bar_color_light.green }}, {{ section.settings.progress_bar_color_light.blue }});
    {% else %}
      background: rgba(var(--color-highlight));
    {% endif %}
    width: var(--pagination-width);
    transition: width ease-in-out 0.5s;
  }
  .dark .quiz-pagination-{{ section.id }}::after {
    {% if section.settings.progress_bar_color_dark.alpha != 0.0 %}
      background: rgba({{ section.settings.progress_bar_color_dark.red }}, {{ section.settings.progress_bar_color_dark.green }}, {{ section.settings.progress_bar_color_dark.blue }});
    {% else %}
      background: rgba(var(--color-highlight));
    {% endif %}
  }
  .section-quiz-{{ section.id }}.active .quiz-pagination-{{ section.id }} {
    visibility: visible;
  }
  #quiz-answer-product-list-{{ section.id }} > .recommended-product:nth-child(-n + {{ section.settings.max_products }}) {
    display: block;
  }
  #quiz-answer-product-list-{{ section.id }} .recommended-product {
    width: 100%;
    {% if is_rtl %}
      text-align: right;
    {% else %}
      text-align: left;
    {% endif %}
  }
  @media (min-width: 768px) {
    #quiz-answer-product-list-{{ section.id }} .recommended-product {
      width: calc(50% - 8px);
    }
  }
{%- endstyle -%}

{%- if section.settings.show_section_divider or section.settings.show_section_divider_mobile -%}
  {% render 'section-divider' %}
{%- endif -%}

{%- if section.index == null and search.results_count > 0 -%}
  <div id="quiz-answer-product-list" class="hidden">
    {% assign result = search.results | sort: 'published_at' | reverse %}
    {% for item in result %}
      <div id="{{ item.id }}" data-no-variant="{{ item.has_only_default_variant }}" data-product-available="{{ item.available }}" class="hidden recommended-product {{ item.published_at }}">
        {% render 'mini-card-product-quiz',
          card_product: item,
          section_id: section.id,
          index: forloop.index,
          media_aspect_ratio: settings.product_image_ratio,
          ratio: ratio,
          loading: loading,
          is_rtl: is_rtl,
          has_add_all: has_add_all
        %}
      </div>
    {% endfor %}
  </div>
{% endif %}
<div
  x-data="xQuiz('{{ section.id }}', {{ section.settings.max_products }}, [{{ default_recommended_product_ids }}])"
  :class="curIndex > 0 && 'active'"
  class="section-quiz flex flex-col relative overflow-hidden section-quiz-{{ section.id }} bg-[rgba(var(--colors-background))] w-full section-padding-{{ section.id }}{% unless section.settings.full_width_mobile %} pl-5 pr-5{% else %} pl-0 pr-0{% endunless %}{% if section.settings.full_width %}{% if section.settings.padding_full_width %} md:pl-5 md:pr-5{% else %} md:pl-0 md:pr-0{% endif %}{% else %}{% if settings.edges_type == 'rounded_corners' %} md:rounded-[10px]{% else %} md:rounded-none{% endif %} x-pgw page-width{% endif %}"
>
  <div
    {% unless request.visual_preview_mode %}
      x-show="curIndex === 0"
      x-transition:leave="transition-opacity duration-200 ease-in-out"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
    {% endunless %}
    class="quiz-intro pl-1 pr-1 gap-3 overflow-y-auto scrollbar-body flex flex-col text-{{ text_alignment }} rtl:text-{{ rtl_alignment }} quiz-intro-height-{{ section.id }}"
  >
    {% liquid 
      assign bg_image = section.settings.bg_image
      assign bg_image_mobile = section.settings.bg_image_mobile
    %}
    {%- if bg_image or bg_image_mobile -%}
      {% # theme-check-disable ImgLazyLoading %}
      {% if bg_image %}
        <div class="{% if bg_image_mobile %}md:block hidden {% endif %}h-full w-full animate-Xpulse skeleton-image">
          <img
            class="block max-w-full absolute top-0 left-0 h-full w-full object-cover object-center"
            srcset="{{ bg_image | image_url: width: 375 }} 375w,
              {{ bg_image | image_url: width: 450 }} 450w,
              {{ bg_image | image_url: width: 750 }} 750w,
              {{ bg_image | image_url: width: 900 }} 900w,
              {{ bg_image | image_url: width: 1100 }} 1100w,
              {{ bg_image | image_url: width: 1500 }} 1500w,
              {{ bg_image | image_url: width: 1780 }} 1780w,
              {{ bg_image | image_url: width: 2000 }} 2000w,
              {{ bg_image | image_url: width: 3000 }} 3000w,
              {{ bg_image | image_url: width: 3840 }} 3840w"
            sizes="{% if section.settings.full_width %}100vw{% else %}(min-width: 768px) {{ settings.page_width }}px, 100vw{% endif %}"
            src="{{ bg_image | image_url: width: 3840 }}"
            {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
            onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); });"
            alt="{{ bg_image.alt | escape }}"
            width="{{ bg_image.width }}"
            height="{{ bg_image.height }}"
            style="object-position: {{ bg_image.presentation.focal_point }};"
          >
        </div>
      {% endif %}
      {% if bg_image_mobile %}
        <div class="block md:hidden h-full w-full animate-Xpulse skeleton-image">
          <img
            class="block max-w-full absolute top-0 left-0 h-full w-full object-cover object-center"
            srcset="{{ bg_image_mobile | image_url: width: 375 }} 375w,
              {{ bg_image_mobile | image_url: width: 450 }} 450w,
              {{ bg_image_mobile | image_url: width: 750 }} 750w,
              {{ bg_image_mobile | image_url: width: 900 }} 900w"
            sizes="100vw"
            src="{{ bg_image_mobile | image_url: width: 900 }}"
            {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
            onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); });"
            alt="{{ bg_image_mobile.alt | escape }}"
            width="{{ bg_image_mobile.width }}"
            height="{{ bg_image_mobile.height }}"
            style="object-position: {{ bg_image_mobile.presentation.focal_point }};"
          >
        </div>
      {% endif %}
      {% # theme-check-enable ImgLazyLoading %}
      <span class="{% unless bg_image %}block md:hidden {% endunless%}absolute top-0 left-0 bottom-0 right-0 image-treatment-overlay opacity-{{ section.settings.image_overlay_opacity }}"></span>
    {%- endif -%}
    <div class="h-fit z-10">
      {%- if section.settings.subheading != blank -%}
        <div
          class="mb-1.5{% unless settings.disable_heading_animation %} overflow-hidden{% endunless %}"
          {% unless settings.disable_heading_animation %}
            x-intersect.once="$el.querySelector('.anm-move-up')?.classList.add('active-anm-heading')"
          {% endunless %}
        >
          <p class="subheading rte subheading-color--{{ section.id }}{% unless settings.disable_heading_animation %} anm-move-up{% endunless %}">
            {{ section.settings.subheading }}
          </p>
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <div class="pt-2 pb-2 heading-{{ section.id }}">
          {% render 'heading-highlight',
            headingId: section.id,
            heading: section.settings.heading,
            highlight_type: section.settings.highlight_type,
            color_heading_highlight_light: section.settings.heading_highlight_color_light,
            color_heading_highlight_dark: section.settings.heading_highlight_color_dark,
            class: 'h2 block leading-tight',
            heading_tag: section.settings.heading_tag,
            animation_heading: true,
            run_on_intersect: true
          %}
        </div>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte mt-2 mb-4 text-color--{{ section.id }}">{{ section.settings.text }}</div>
      {%- endif -%}
      {% assign start_button_label = section.settings.button_label %}
      {% if start_button_label == blank %}
        {% assign start_button_label = 'quiz.start_quiz' | t %}
      {% endif %}
      <div class="button-quiz-{{ section.id }} flex {% if text_alignment == 'center' %}justify-center{% elsif text_alignment == 'right' %}justify-end{% else %}justify-start{% endif %} mt-6">
        <button
          disabled
          @click.prevent="start()"
          type="button"
          class="button button-solid leading-normal disabled:cursor-not-allowed disabled:opacity-30 pl-7 pr-7 pt-2.5 pb-2.5 md:pl-8 md:pr-8 md:pt-3 md:pb-3"
        >
          {% render 'button-label', button_label: start_button_label, show_button_style: 'primary' %}
        </button>
      </div>
    </div>
    {%- if section.settings.note != blank -%}
      <p class="rte text-color--{{ section.id }} z-10">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
  <div
    x-show="curIndex > 0"
    x-cloak
    id="x-quiz-questions-container-{{ section.id }}"
    class="quiz-questions relative flex flex-col"
  >
    {% content_for 'blocks' %}
    <div
      id="x-quiz-answer-container-{{ section.id }}"
      x-show="curIndex === totalQuestions + 1"
      x-cloak
      x-transition:enter="transition-opacity duration-500 ease-in-out delay-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      class="quiz-answer grow w-full flex flex-col{% if section.settings.full_width_mobile %} pl-5 pr-5{% else %} pl-0 pr-0{% endif %}{% if section.settings.full_width %} md:pl-10 md:pr-10{% endif %} x-pgw page-width text-{{ answer_text_alignment }} rtl:text-{{ answer_rtl_alignment }}"
    >
      <div class="answer-heading-container mt-5 pb-5 border-b empty:hidden">
        {%- if section.settings.answer_subheading != blank -%}
          <div class="mb-1.5">
            <p class="subheading rte subheading-color--{{ section.id }}">{{ section.settings.answer_subheading }}</p>
          </div>
        {%- endif -%}
        {%- if section.settings.answer_heading != blank -%}
          {% assign answer_heading_id = 'answer-' | append: section.id %}
          <div class="pt-2 pb-2 heading-{{ section.id }}">
            {% render 'heading-highlight',
              headingId: answer_heading_id,
              heading: section.settings.answer_heading,
              highlight_type: section.settings.answer_heading_highlight_type,
              color_heading_highlight_light: section.settings.heading_highlight_color_light,
              color_heading_highlight_dark: section.settings.heading_highlight_color_dark,
              class: 'h2 block leading-tight',
              heading_tag: section.settings.answer_heading_tag
            %}
          </div>
        {%- endif -%}
        {%- if section.settings.answer_text != blank -%}
          <div class="rte mt-2 text-color--{{ section.id }}">{{ section.settings.answer_text }}</div>
        {%- endif -%}
      </div>
      <div class="answer-content-container mt-6 w-full h-0 grow bg-[rgba(var(--colors-background-secondary))] content-center{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}">
        <div x-show="!hasProducts" class="empty-recommendation-container flex flex-col text-center items-center max-h-full overflow-y-auto scrollbar-body">
          <div class="answer-text-header font-bold mb-2 md:mb-4">{{ 'quiz.no_product' | t }}</div>
          <div class="flex flex-col md:flex-row gap-2 md:gap-4 items-center">
            {% assign retake_button_label = section.settings.retake_button_label %}
            {% assign all_product_button_label = 'quiz.all_product_button' | t %}
            {% if retake_button_label == blank %}
              {% assign retake_button_label = 'quiz.retake_button' | t %}
            {% endif %}
            <button
              @click.prevent="reset()"
              class="w-fit button-quiz-{{ section.id }} button button-solid cursor-pointer flex gap-1 pt-3 pb-3 pl-6 pr-6 leading-normal text-center uppercase font-semibold{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %} border border-solid border-[rgba(var(--colors-button))] text-[rgba(var(--colors-button))]"
            >
              {% render 'button-label', button_label: retake_button_label, show_button_style: 'primary' %}
            </button>
            <button
              @click.prevent="window.location.href='{{ routes.all_products_collection_url }}'"
              class="w-fit button-quiz-{{ section.id }} button button-solid cursor-pointer flex gap-1 pt-3 pb-3 pl-6 pr-6 leading-normal text-center uppercase font-semibold{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %} bg-[rgba(var(--colors-button))] text-[rgba(var(--colors-button-text))]"
            >
              {% render 'button-label', button_label: all_product_button_label, show_button_style: 'primary' %}
            </button>
          </div>
        </div>
        <div
          x-show="hasProducts"
          class="answer-container max-h-full overflow-y-auto scrollbar-body grid grid-cols-1 md:grid-cols-2 gap-x-5 pt-5 pb-5 pl-5 pr-5"
        >
          <div class="answer-text-container text-color--{{ section.id }}">
            <div class="answer-text-header font-bold">{{ 'quiz.answer_text_header' | t }}</div>
            <div id="quiz-answer-text-{{ section.id }}" class="rte"></div>
          </div>
          <div
            id="quiz-answer-product-list-{{ section.id }}"
            class="answer-product-container h-fit flex flex-wrap gap-4 {% if answer_text_alignment == 'center' %}justify-center{% elsif answer_text_alignment == 'right' %}justify-end{% else %}justify-start{% endif %}"
          ></div>
        </div>
      </div>
    </div>
    <div
      :style="{ '--pagination-width': _getPaginationWidth() + '%' }"
      class="quiz-pagination-{{ section.id }} w-full pt-2 mt-5 relative after:absolute z-10 invisible"
    ></div>
    <div
      x-show="curIndex > 0 && hasProducts"
      x-cloak
      id="x-quiz-nav-{{ section.id }}"
      class="quiz-nav w-full pt-5 pb-5{% if section.settings.full_width_mobile %} pl-5 pr-5{% else %} pl-0 pr-0{% endif %}{% if section.settings.full_width %} md:pl-10 md:pr-10{% endif %} x-pgw page-width"
    >
      <div x-show="curIndex < (totalQuestions + 1)" class="w-full flex justify-between">
        <button
          @click.prevent="prev()"
          :disabled="traversed.length === 0"
          class="button-quiz-{{ section.id }} button button-outline disabled:cursor-not-allowed disabled:opacity-30 cursor-pointer flex gap-1 pt-3 pb-3 pl-6 pr-6 leading-normal text-center uppercase font-semibold"
        >
          {% assign nav_button_previous_label = 'quiz.nav_button_previous' | t %}
          {% render 'button-label', button_label: nav_button_previous_label, show_button_style: 'secondary' %}
        </button>
        <button
          @click.prevent="next()"
          :disabled="!hasCurrentAnswer()"
          class="button-quiz-{{ section.id }} relative button button-solid disabled:cursor-not-allowed disabled:opacity-30 cursor-pointer pt-3 pb-3 pl-6 pr-6 leading-normal text-center uppercase font-semibold"
        >
          <div :class="loading && 'invisible'">
            <div x-show="!isLastQuestion()">
              {% assign nav_button_continue_label = 'quiz.nav_button_continue' | t %}
              {% render 'button-label', button_label: nav_button_continue_label, show_button_style: 'primary' %}
            </div>
            <div x-show="isLastQuestion()">
              {% assign nav_button_submit_label = 'quiz.nav_button_submit' | t %}
              {% render 'button-label', button_label: nav_button_submit_label, show_button_style: 'primary' %}
            </div>
          </div>
          <div x-show="loading" class="w-4 h-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
            {% render 'icon-alls', icon: 'icon-loading' %}
          </div>
        </button>
      </div>
      <div {% if has_add_all %}x-data="xProductsList('{{ section.id }}')"{% endif %} x-show="curIndex === (totalQuestions + 1)" class="w-full flex items-center{% if section.settings.retake_button_label != blank and has_add_all %} flex-row justify-between{% else %} flex-col md:flex-row justify-center md:justify-between{% endif %}">
        {%- if section.settings.retake_button_label != blank -%}
          <button
            @click.prevent="reset()"
            class="button-quiz-{{ section.id }} button button-outline cursor-pointer w-fit flex gap-1 pt-3 pb-3 pl-6 pr-6 leading-normal text-center uppercase font-semibold"
          >
            {% render 'button-label',
              button_label: section.settings.retake_button_label,
              show_button_style: 'secondary'
            %}
          </button>
        {%- endif -%}
        {%- if has_add_all -%}
          <button
            id="add-all-button-{{ section.id }}"
            @click.prevent="hasVariant ? openVariantContainer() : handleAddToCart($el, '.section-quiz', '#quiz-answer-product-list-{{ section.id }} > .recommended-product:nth-child(-n + {{ section.settings.max_products }}) form', '{{ settings.name_edt | default: "Note" }}')"
            class="button-quiz-{{ section.id }} button button-solid relative disabled:cursor-not-allowed disabled:opacity-30 cursor-pointer w-fit flex gap-1 pt-3 pb-3 pl-6 pr-6 leading-normal text-center uppercase font-semibold"
          >
            <template x-if="!hasVariant">
              <div>
                <span :class="loading && 'invisible'">
                  {% render 'button-label', button_label: section.settings.add_all_button_label, show_button_style: 'primary' %}
                </span>
                <div x-show="loading" class="w-4 h-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                  {% render 'icon-alls', icon: 'icon-loading' %}
                </div>
              </div>
            </template>
            <template  x-if="hasVariant">
              {% render 'button-label', button_label: section.settings.add_all_button_label, show_button_style: 'primary' %}
            </template>
          </button>
          {% style %}
            #variant-container-{{ section.id }} .card-product {
              width: calc(80% + max(0%, (2 - var(--product-num)) * 20%));
            }
            #variant-container-{{ section.id }} .card-product:not(:last-child) {
              {% if is_rtl %}
                margin-left: 16px;
              {% else %}
                margin-right: 16px;
              {% endif %}
            }
            @media (min-width: 768px) {
              .x-quiz-product-variant-modal .product-variant-modal {
                --col-num: min(var(--product-num), 3);
                max-width: calc(var(--col-num) * (25% + 16px) + 208px / var(--col-num) - 16px);
              }
              #variant-container-{{ section.id }} .card-product {
                width: calc((100%  - 16px * (var(--col-num) - 1)) / var(--col-num));
              }
            }
            @media (min-width: 1536px) {
              .x-quiz-product-variant-modal .product-variant-modal {
                max-width: calc(var(--col-num) * (20% + 16px) + 208px / var(--col-num) - 16px);
              }
            }
          {% endstyle %}
          <div x-cloak x-show="showModal" class="x-quiz-product-variant-modal flex items-end md:items-center fixed top-0 left-0 right-0 bottom-0 z-[90]">
            <div class="x-overlay absolute top-0 left-0 right-0 bottom-0 bg-[#acacac] bg-opacity-30"></div>
            <div 
              x-show="showModal"
              x-transition:enter="transition-all ease-in-out duration-500"
              x-transition:enter-start="opacity-0 transform translate-y-1/3"
              x-transition:enter-end="opacity-100 transform translate-y-0"
              x-transition:leave="transition-all ease-in-out duration-500"
              x-transition:leave-end="opacity-0 transform translate-y-1/3"
              class="product-variant-modal w-full ml-auto mr-auto pl-0 pr-0 md:pl-5 md:pr-5 lg:pl-16 lg:pr-16 lg:ml-auto lg:mr-auto z-10"
            >
              <div
                @click.away="closeVariantContainer()" 
                class="flex flex-col md:h-auto gap-6 bg-[rgba(var(--background-color))] shadow-popup pt-5 pl-10 pr-10 pb-10{% if settings.edges_type == 'rounded_corners' %} rounded-t-[10px] md:rounded-[10px]{% endif %}"
              >
                <div class="flex justify-between items-center">
                  <p class="h3 leading-tight p-break-words w-[calc(100%-40px)] font-semibold">SELECT OPTIONS</p>
                  <button aria-label="Close variant container" id="QuickViewClose" class="w-fit z-10 group-close-btn icon-close-container rounded-full" @click.prevent="closeVariantContainer()">
                    {% render 'icon-alls', icon: 'icon-close', animation_class: 'icon-close-animation' %}
                  </button>
                </div>
                <div 
                  id="variant-splide-{{ section.id }}"
                  class="x-splide splide w-full visible overflow-hidden"
                  x-data-slider="{{ section.id }}"
                  x-intersect.once.margin.200px='$store.xSplide.load($el, {
                    "speed": 1000,
                    "pagination": false, 
                    "mediaQuery": "min",
                    "updateOnMove": "true",
                    "progressBar": "4",
                    "progressBarHeader": "true",
                    "omitEnd": "true",
                    {%- if is_rtl %} 
                      "direction": "rtl",
                    {%- endif %}
                    "autoWidth": "true",
                    "perMove": 1,
                    "breakpoints": {
                      300: {
                        "focus": "center",
                      },
                      768: {
                        "focus": 0,
                      }
                    },
                    "events": [
                      {
                        "event": "ready",
                        "callback": () => {
                          document.dispatchEvent(new CustomEvent("eurus:{{ section.id }}:splide-ready"));
                        }
                      },
                      {
                        "event": "overflow",
                        "callback": (isOverflow) => {
                          $el.splide.options = {
                            arrows: isOverflow,
                            drag: isOverflow
                          } 
                        }
                      }
                    ]
                  })'
                >
                  <div class="splide__arrows items-center justify-center gap-3 w-full order-2 hidden md:flex">
                    <button 
                      class="splide__arrow splide__arrow--prev button-arrow pt-3 pb-3 pl-3 pr-3 rounded-full border md:border-0 border-solid z-10 w-11 h-11 after:text-[20px] rtl:rotate-180 opacity-100 disabled:cursor-not-allowed disabled:opacity-30 md:block md:absolute md:top-1/2 md:-mt-6 rtl:md:left-auto rtl:md:right-0 md:left-0 md:duration-200 md:opacity-60 hover:opacity-100 md:transition-all md:ease-in-out md:-translate-x-full rtl:md:translate-x-full"
                      aria-label="previous slide"
                    >
                      <span class="hidden">previous slide</span>
                      {% render 'icon-labels-bags', icon: 'chevron-left' %}
                    </button>
                    <button 
                      class="splide__arrow splide__arrow--next button-arrow pt-3 pb-3 pl-3 pr-3 rounded-full border md:border-0 border-solid z-10 w-11 h-11 after:text-[20px] rtl:rotate-180 opacity-100 disabled:cursor-not-allowed disabled:opacity-30 md:block md:absolute md:top-1/2 md:-mt-6 rtl:md:right-auto rtl:md:left-0 md:right-0 md:duration-200 md:opacity-60 hover:opacity-100 md:transition-all md:ease-in-out md:translate-x-full rtl:md:-translate-x-full"
                      aria-label="next slide"
                    >
                      <span class="hidden">next slide</span>
                      {% render 'icon-labels-bags', icon: 'chevron-right' %}
                    </button>
                  </div>
                  <div :class="productNumQuiz > 3 && 'md:cursor-grab'" class="splide__track w-full lg:pl-0 lg:pr-0">
                    <div 
                      id="variant-container-{{ section.id }}" 
                      x-intersect.full="$el.closest('.splide')?.splide?.refresh()"
                      class="splide__list relative md:flex md:w-full flex w-full max-h-[80vh] scrollbar-body md:h-auto"
                    >
                    </div>
                  </div>
                  <div :class="productNumQuiz > 1 ? ( productNumQuiz > 3 ? 'flex' : 'flex md:hidden' ) : 'hidden'" class="items-center w-full gap-5 mt-2.5 md:mt-5">
                    <div class="splide-progress inline-block grow rounded-md">
                      {%- style -%}
                        .splide-progress-bar-{{ section.id }} {
                          width: calc(100% / var(--product-num));
                        }
                        @media (min-width: 768px) {
                          .splide-progress-bar-{{ section.id }} {
                            width: calc(300% / var(--product-num));
                          }
                        }
                      {%- endstyle -%}
                      <div class="splide-progress-bar-{{ section.id }} splide-progress-bar rounded-md"></div>
                    </div>
                  </div>
                </div>
                <button id="variant-popup-add-all-{{ section.id }}" x-intersect="checkSelectedVariants($el)" @click="handleAddToCart($el, '.section-quiz' , '#quiz-answer-product-list-{{ section.id }} > .recommended-product:nth-child(-n + {{ section.settings.max_products }}) form, #variant-container-{{ section.id }} .card-product form', '{{ settings.name_edt | default: "Note" }}')" class="button-quiz-{{ section.id }} button button-solid relative w-full disabled:cursor-not-allowed disabled:opacity-30 cursor-pointer pt-3 pb-3 pl-6 pr-6 leading-normal text-center uppercase font-semibold">
                  <span :class="loading && 'invisible'">
                    {% render 'button-label', button_label: section.settings.add_all_button_label, show_button_style: 'primary' %}
                  </span>
                  <div x-show="loading" class="w-4 h-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                    {% render 'icon-alls', icon: 'icon-loading' %}
                  </div>
                </button>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% if has_add_all %}
  <script src="{{ 'product-list.js' | asset_url }}" defer></script>
{% endif %}
<script src="{{ 'quiz.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "t:sections.quiz.name",
  "class": "section x-section section-quiz",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "blocks": [
    {
      "type": "_question"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.text.heading",
      "info": "t:settings_schema.typography.settings.heading_highlight_type.info",
      "default": "Find your personalized recommendations"
    },
    {
      "type": "select",
      "id": "highlight_type",
      "default": "underline",
      "label": "t:settings_schema.typography.settings.heading_highlight_type.label",
      "options": [
        {
          "value": "underline",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__1.label"
        },
        {
          "value": "font_highlight",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 50,
      "max": 200,
      "unit": "%",
      "step": 10,
      "default": 100,
      "label": "t:sections.all.text.heading_size"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h2",
      "label": "t:sections.all.text.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.testimonials.text_alignment.label",
      "options": [
        {
          "label": "t:sections.all.content_alignment.options__1.label",
          "value": "left"
        },
        {
          "label": "t:sections.all.content_alignment.options__2.label",
          "value": "center"
        },
        {
          "label": "t:sections.all.content_alignment.options__3.label",
          "value": "right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.all.content_position.options__11.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.all.content_position.options__12.label"
        }
      ],
      "default": "center",
      "label": "t:sections.image-with-text.settings.text_position.label",
      "info": "t:settings_schema.cart.settings.cart_page_layout.info",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.text.subheading",
      "default": "Example subheading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings_schema.seo.business_description.label",
      "default": "<p>Provide a brief introduction to the quiz, explaining the analysis process and the results customers can expect.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "note",
      "label": "t:sections.quiz.settings.note.label",
      "default": "Add your quiz note here."
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "START THE QUIZ",
      "label": "t:sections.all.button.label"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:sections.email-signup-banner.settings.image.label",
      "info": "t:sections.all.image.note_image_size"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "t:sections.promotion-banner.settings.image_mobile.label",
      "info": "t:sections.all.image.note_image_size"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.all.overlay_opacity.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.quiz.settings.result"
    },
    {
      "type": "text",
      "id": "answer_heading",
      "label": "t:sections.all.text.heading",
      "info": "t:settings_schema.typography.settings.heading_highlight_type.info",
      "default": "Find your personalized recommendations"
    },
    {
      "type": "select",
      "id": "answer_heading_highlight_type",
      "default": "underline",
      "label": "t:settings_schema.typography.settings.heading_highlight_type.label",
      "options": [
        {
          "value": "underline",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__1.label"
        },
        {
          "value": "font_highlight",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "answer_heading_size",
      "min": 50,
      "max": 200,
      "unit": "%",
      "step": 10,
      "default": 100,
      "label": "t:sections.all.text.heading_size"
    },
    {
      "type": "select",
      "id": "answer_heading_tag",
      "default": "h2",
      "label": "t:sections.all.text.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        }
      ]
    },
    {
      "type": "select",
      "id": "answer_text_alignment",
      "label": "t:sections.testimonials.text_alignment.label",
      "options": [
        {
          "label": "t:sections.all.content_alignment.options__1.label",
          "value": "left"
        },
        {
          "label": "t:sections.all.content_alignment.options__2.label",
          "value": "center"
        },
        {
          "label": "t:sections.all.content_alignment.options__3.label",
          "value": "right"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "answer_subheading",
      "label": "t:sections.all.text.subheading",
      "default": "Example subheading"
    },
    {
      "type": "richtext",
      "id": "answer_text",
      "label": "t:settings_schema.seo.business_description.label",
      "default": "<p>Provide a brief introduction to the quiz, explaining the analysis process and the results customers can expect.</p>"
    },
    {
      "type": "text",
      "id": "retake_button_label",
      "default": "Reset Quiz",
      "label": "t:sections.quiz.settings.retake_button_label.label"
    },
    {
      "type": "text",
      "id": "add_all_button_label",
      "default": "Add all to cart",
      "label": "Add all button label"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:sections.quiz.settings.max_products.label",
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "product_list",
      "id": "default_recommended_product",
      "label": "t:sections.quiz.settings.default_recommended_product.label",
      "info": "t:sections.quiz.settings.default_recommended_product.info",
      "limit": 5
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.all.full_width.label"
    },
    {
      "type": "checkbox",
      "id": "padding_full_width",
      "default": false,
      "label": "t:sections.all.padding.padding_full_width.label",
      "info": "t:sections.all.padding.padding_full_width.info",
      "visible_if": "{{ section.settings.full_width }}"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:sections.all.show_section_divider.label"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "options": [
