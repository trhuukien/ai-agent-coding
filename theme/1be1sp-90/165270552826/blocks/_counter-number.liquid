{% if block.settings.number != blank %}
    {% liquid
      assign desktop_width = block.settings.desktop_width | times: 1
      assign mobile_width = block.settings.mobile_width | times: 1
    %}
    {% style %}
    .counter-number-{{ block.id }} {
      font-family: {% if block.settings.font == 'heading_font' %} var(--font-heading-family) {% else %} var(--font-body-family) {% endif %};
      {% if block.settings.number_color_light.alpha != 0.0 %}
        color: {{ block.settings.number_color_light }};
      {% else %}
        color: var(--colors-text);
      {%- endif -%}
    }
    .dark .counter-number-{{ block.id }} {
      {% if block.settings.number_color_dark.alpha != 0.0 %}
        color: {{ block.settings.number_color_dark }};
      {% else %}
        color: var(--colors-text);
      {%- endif -%}
    }
    .counter-number-{{ block.id }} .prefix-{{ block.id }} {
      font-size: {{ block.settings.prefix_font_size | times: 0.6 }}px;
    }
    .counter-number-{{ block.id }} .suffix-{{ block.id }} {
      font-size: {{ block.settings.suffix_font_size | times: 0.6 }}px;
    }
    .counter-number-{{ block.id }} .number-{{ block.id }} {
      font-size: {{ block.settings.font_size | times: 0.6 }}px;
    }
    .flexible-area-counter-number:has(.width-{{ block.id }}) {
      {% if mobile_width < 100 %}
        width: calc({{ mobile_width }}% - 100px);
        flex-grow: 1;
        max-width: {{ mobile_width }}%;
      {% else %}
        width: 100%;
        max-width: 100%;
      {% endif %}
    }   
    @media (min-width: 768px) {
      .counter-number-{{ block.id }} .prefix-{{ block.id }} {
        font-size: {{ block.settings.prefix_font_size }}px;
      }
      .counter-number-{{ block.id }} .suffix-{{ block.id }} {
        font-size: {{ block.settings.suffix_font_size }}px;
      }
      .counter-number-{{ block.id }} .number-{{ block.id }} {
        font-size: {{ block.settings.font_size }}px;
      }
     .flexible-area-counter-number:has(.width-{{ block.id }}) {
        {% if desktop_width < 100 %}
          width: calc({{ desktop_width }}% - 100px);
          flex-grow: 1;
          max-width: {{ desktop_width }}%;
        {% else %}
          width: 100%;
          max-width: 100%;
        {% endif %}
      }
    }
    {% endstyle %}
    <div 
        data-width="{{ desktop_width }}" 
        data-width-mobile="{{ mobile_width }}" 
        class="item-block counter-number-{{ block.id }} width-{{ block.id }} flex flex-nowrap item-group-content-alignment-mobile item-group-content-alignment counter-content-alignment-mobile counter-content-alignment overflow-auto hide-scrollbar font-{{ block.settings.font_weight }}"
        x-data="xCounterNumber({
          target: {{ block.settings.number | times: 1 | round: 2 }},
          locale: '{{ block.settings.number_format }}',
          duration: 2000
        })"
        x-intersect.once="start()"
    >
        <span class="prefix-{{ block.id }} self-center">{{ block.settings.prefix }}</span>
        <span x-text="number" class="number-{{ block.id }} self-center"></span>
        <span class="suffix-{{ block.id }} self-center">{{ block.settings.suffix }}</span>
    </div>
    <script src="{{ 'counter-number.js' | asset_url }}" defer></script>
{% endif %}
