{% style %}
  .contact-date-time::-webkit-datetime-edit {opacity: 0}
  .contact-date-time.focus-input::-webkit-datetime-edit {-webkit-transition: 200ms;transition: 200ms;opacity: 1}
  .contact-date-time.focus-input+.label-date, .contact-date-time:focus+.label-date, .rtl .contact-date-time+.label-date {font-size: .75rem;line-height: 1rem;top: .75rem}
  .contact-date-time.focus-input, .contact-date-time:focus, .rtl .contact-date-time {padding-top: 1.25rem;padding-bottom: .5rem}
  @supports (-moz-appearance: none){
    .contact-date-time.input-date-time+.label-date {font-size: .75rem;line-height: 1rem;top: .75rem}
    .contact-date-time.input-date-time {padding-top: 1.25rem;padding-bottom: .5rem}}
  .contact-align-right{display:flex;flex-direction:column}
  .contact-align-left{display:flex;flex-direction:column}
  .contact-info-align.align-left{padding-left:0px;padding-top:1.75rem}
  .contact-info-align.align-right{padding-right:0px;padding-bottom:1.75rem;padding-top:1.75rem}
  .contact-has-image.page-width .form-align-right{padding-top:0.75rem}
  .dark .contact-has-image.page-width .form-align-right{padding-top:0.75rem}
  .contact-form-both .heading-form{border-top-width:1px;padding-top:1.5rem}
  .contact-has-image.md\:page-width .form-align-right{padding-top:0.75rem}
  .dark .contact-has-image.md\:page-width .form-align-right{padding-top:0.75rem}
{% endstyle %}
{% liquid
  assign heading_size = section.settings.heading_size | times: settings.heading_base_size | times: 0.000225
  assign form_id = 'ContactForm-' | append: section.id

  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
  else
    assign is_rtl = false
  endif

  #set padding left and right when set up background color light or dark
  if section.settings.full_width_mobile
    assign padding_bg = 'pr-5 pl-5'
  else
    if section.settings.background_color_light.alpha != 0.0
      if section.settings.background_color_dark.alpha != 0.0
        assign padding_bg = 'pr-5 pl-5'
      else
        assign padding_bg = 'pr-5 pl-5 dark:pr-0 dark:pl-0'
      endif
    else
      if section.settings.background_color_dark.alpha != 0.0
        assign padding_bg = 'dark:pr-5 pl-5'
      endif
    endif
  endif
%}
{%- style -%}
  .section-padding-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 768px) {
    .section-padding-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {% if section.settings.image != blank %}
    .contact-form-{{ section.id }} {
       {% if section.settings.background_color_light.alpha == 0.0 %}
        background: transparent;
      {% else %}
        background: {{ section.settings.background_color_light }};
      {% endif %}
    }
    .dark .contact-form-{{ section.id }}{
      {% if section.settings.background_color_dark.alpha == 0.0 %}
        background: transparent;
      {% else %}
        background: {{ section.settings.background_color_dark }};
      {% endif %}
    }
  {% else %}
    #shopify-section-{{ section.id }}{
      {% if section.settings.background_color_light.alpha == 0.0 %}
        background: transparent;
        --background-color: {{ settings.colors_background.red }}, {{ settings.colors_background.green }}, {{ settings.colors_background.blue }};
      {% else %}
        background: {{ section.settings.background_color_light }};
        --background-color: {{ section.settings.background_color_light.red }}, {{ section.settings.background_color_light.green }}, {{ section.settings.background_color_light.blue }};
      {% endif %}
    }
    .dark #shopify-section-{{ section.id }}{
      {% if section.settings.background_color_dark.alpha == 0.0 %}
        background: transparent;
        --background-color: {{ settings.colors_dark_background.red }}, {{ settings.colors_dark_background.green }}, {{ settings.colors_dark_background.blue }};
      {% else %}
        background: {{ section.settings.background_color_dark }};
        --background-color: {{ section.settings.background_color_dark.red }}, {{ section.settings.background_color_dark.green }}, {{ section.settings.background_color_dark.blue }};
      {% endif %}
    }
  {% endif %}
{%- endstyle -%}

{% render 'section-divider' %}

{%- if section.settings.heading != blank -%}
  {%- style -%}
    .heading-{{ section.id }} { font-size: {{ heading_size | times: 0.6 }}rem; }
    @media screen and (min-width: 1025px) {
      .heading-{{ section.id }}{
        font-size: {{ heading_size }}rem;
      }
    }
  {%- endstyle -%}
{%- endif -%}
<div class="x-container-contact-form-{{ section.id }}">
  <div class="x-container-contact-form max-w-xl mr-auto ml-auto section-padding-{{ section.id }}">
    <div class="contact-form-{{ section.id }} flex flex-col md:gap-y-0 md:flex-row w-full gap-y-7{% if is_rtl %} ltr{% endif -%} pt-7 lg:pt-0 rtl:pb-7 rtl:lg:pb-0 rtl:pt-0 x-pgw page-width pr-5 pl-5">
      <div class="min-w-4 contact-form-container flex justify-center md:pl-5 md:pr-5 w-full {{ padding_bg }}{% if is_rtl %} rtl{% endif -%} pb-7 rtl:pt-7 md:justify-start rtl:md:justify-end"
      >
        <div x-data="{ requestType: 'return' }" class="contact-form w-full max-w-[{{ settings.page_width | divided_by: 2 }}px]">
          <div class="heading-form empty:hidden text-{{ section.settings.heading_alignment }} rtl:text-{% if section.settings.heading_alignment == 'center' %}center{% elsif section.settings.heading_alignment == 'left' %}right{% else %}left{% endif %}{% if section.settings.heading != blank or section.settings.text != blank %} mb-6 md:mb-8{% endif %}">
            {%- if section.settings.heading != blank -%}
              {% render 'heading-highlight',
                headingId: section.id,
                heading: section.settings.heading,
                highlight_type: section.settings.highlight_type,
                class: 'h2 block leading-tight',
                heading_tag: section.settings.heading_tag,
                animation_heading: true
              %}
            {%- endif -%}
            {% if section.settings.text != blank %}
              <div class="rte mt-2 lg:mt-4">
                {{ section.settings.text }}
              </div>
            {% endif %}
          </div>
          {%- form 'contact', id: form_id, class: 'eurus' -%}
            {%- if form.posted_successfully? -%}
              <div class="flex items-center pl-4 pr-4 pt-3.5 pb-3.5 mb-3 bg-[rgba(var(--color-success),0.2)] selection:bg-[rgba(var(--color-success),0.4)] focus:outline-none" tabindex="-1" autofocus>
                <span class="text-[rgba(var(--color-success))] w-5 mr-2">
                  {%- render 'icon-alls', icon: 'icon-success' %}
                </span>
                {%- if section.settings.success_message -%}
                  <p class="leading-tight flex-1">{{ section.settings.success_message }}</p>
                {%- else -%}
                {{ 'templates.contact.form.post_success' | t }}
                {%- endif -%}
              </div>
            {%- elsif form.errors -%}
              <p class="flex items-center pl-4 pr-4 pt-3 pb-3 mb-3 bg-[rgba(var(--color-error),0.2)] selection:bg-[rgba(var(--color-error),0.4)]" tabindex="-1" autofocus>
                <span class="text-[rgba(var(--color-error))] inline-block w-5 mr-2">{% render 'icon-alls', icon: 'icon-error' %} </span>
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            {%- unless form.posted_successfully? -%}
              <div class="contact__fields">
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {%- when 'order_id' -%}
                      <div class="mb-3 lg:mb-4 flex-1 relative" {{ block.shopify_attributes }}>
                        <input
                          type="text"
                          inputmode="numeric"
                          id="ContactFormName-{{ section.id }}"
                          class="w-full pl-5 pr-5 lg:pl-6 lg:pr-6 pt-5 pb-1 md:pt-5 md:pb-2 border focus:outline-none focus:border-current input bg-transparent placeholder:opacity-0{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                          name="contact[{%- if block.settings.heading != blank -%}{{ block.settings.heading }}{%- else -%}orderId{% endif %}]"
                          autocapitalize="words"
                          placeholder="{{ 'templates.contact.form.order_id' | t }}"
                          @input="$el.value = $el.value.replace(/[^0-9]/g, '')"
                          {% if block.settings.mark_as_required %}
                            required
                          {% endif %}
                        >
                        <label class="duration-150 leading-tight absolute top-1/2{% if is_rtl %} right-5 lg:right-6{% else %} left-5 lg:left-6{% endif %} -translate-y-1/2 input_focus:text-xs input_focus:top-3 input_not_empty:top-3 input_not_empty:text-xs" for="ContactFormName-{{ section.id }}">
                          {{- block.settings.heading }}
                          {% if block.settings.mark_as_required %}
                            <span aria-hidden="true">*</span>
                          {%- endif %}
                        </label>
                      </div>
                    {%- when 'email' -%}
                      <div class="mb-3 lg:mb-4 flex-1 relative" {{ block.shopify_attributes }}>
                        <input
                          type="email"
                          id="ContactFormEmail-{{ section.id }}"
                          class="w-full border pl-5 pr-5 lg:pl-6 lg:pr-6 pt-5 pb-1 md:pt-5 md:pb-2 focus:outline-none focus:border-current input bg-transparent placeholder:opacity-0{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                          name="contact[email]"
                          autocomplete="email"
                          autocapitalize="off"
                          autocorrect="off"
                          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                          placeholder="{{ 'customer.email' | t }}"
                          required>
                          <label
                            class="duration-150 leading-tight absolute top-1/2{% if is_rtl %} right-5 lg:right-6{% else %} left-5 lg:left-6{% endif %} -translate-y-1/2 input_focus:text-xs input_focus:top-3 input_not_empty:top-3 input_not_empty:text-xs"
                            for="ContactFormEmail-{{ section.id }}"
                          >
                            {{- block.settings.heading }}
                            <span aria-hidden="true">*</span>
                          </label>
                      </div>
                    {%- when 'description' -%}
                      <div class="mb-2 md:mb-3 relative" {{ block.shopify_attributes }}>
                        <textarea
                          id="ContactFormMessage-{{ section.id }}"
                          class="w-full pl-5 pr-5 lg:pl-6 lg:pr-6 pt-5 pb-1 md:pt-5 md:pb-2 border focus:outline-none focus:border-current input bg-transparent placeholder:opacity-0{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                          rows="4"
                          name="contact[{%- if block.settings.heading != blank -%}{{ block.settings.heading }}{%- else -%}description{% endif %}]"
                          placeholder="{{ 'templates.contact.form.message' | t }}"
                          {% if block.settings.mark_as_required %}
                            required
                          {% endif %}>
                          {{- form.message -}}
                        </textarea>
                        <label
                          class="duration-150 absolute top-3 md:top-4{% if is_rtl %} right-5 lg:right-6{% else %} left-5 lg:left-6{% endif %} input_focus:text-xs input_focus:top-1 input_not_empty:top-1 input_not_empty:text-xs"
                          for="ContactFormMessage-{{ section.id }}"
                        >
                          {{- block.settings.heading }}
                          {% if block.settings.mark_as_required %}
                            <span aria-hidden="true">*</span>
                          {%- endif -%}
                        </label>
                      </div>
                    {%- when 'request_type' -%}
                      {% liquid
                        assign option_keys = "return,cancel" | split: ','
                        assign form_item = 'FormItem-' | append : forloop.index
                        assign contact_form = 'ContactForm-' | append: section.id | append: '-' | append: forloop.index
                      %}
                      <div class="mb-3 lg:mb-4 relative" {{ block.shopify_attributes }}>
                        {%- if block.settings.heading != blank or block.settings.mark_as_required -%}
                          <label
                            class="pb-2 pt-3 block{% if block.settings.type_field == 'dropdown' or block.settings.type_field == 'text' or block.settings.type_field == 'date' or block.settings.type_field == 'time' %} hidden{% endif %}"
                            for="{{ contact_form }}">
                            {{- block.settings.heading }}
                            {% if block.settings.mark_as_required %}
                              <span aria-hidden="true">*</span>
                            {%- endif %}
                          </label>
                        {%- endif -%}
                        <div class="grid md:grid-cols-2 gap-x-7">
                          {%- for key in option_keys -%}
                            {%- assign request_type_label = key | prepend: 'sections.withdrawal_form.request_type.' | t -%}
                            <div class="flex items-center mt-1.5 mb-1.5 cursor-pointer">
                              <input
                                type="radio"
                                id="{{ contact_form }}-{{ forloop.index }}"
                                name="contact[{%- if block.settings.heading != blank -%}{{ block.settings.heading }}{%- else -%}{{ form_item }}{% endif %}]"
                                value="{{ request_type_label }}"
                                class="radio-checked relative h-4 w-4 mr-2 rtl:mr-0 rtl:ml-2 border focus:outline-none rounded-full cursor-pointer"
                                {% if block.settings.mark_as_required -%}
                                  required
                                {%- endif %}
                                {% if forloop.index == 1 %}
                                  checked
                                {% endif -%}
                                @change="if ($el.checked) requestType = '{{ key }}'"
                              >
                              <label for="{{ contact_form }}-{{ forloop.index }}" class="flex-1 cursor-pointer bg-transparent">
                                {{ request_type_label }}
                              </label>
                              <br>
                            </div>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- when 'reason' -%}
                      {% liquid
                        assign keys_return = "changed_my_mind,item_doesnt_fit,item_not_as_described,item_damaged,ordered_by_mistake,found_better_price" | split: ','
                        assign keys_cancel = "changed_my_mind,found_better_price,delivery_too_long,ordered_by_mistake,no_longer_needed" | split: ','
                        assign form_item = 'FormItem-' | append : forloop.index
                        assign contact_form = 'ContactForm-' | append: section.id | append: '-' | append: forloop.index
                      %}
                      <div class="mb-3 lg:mb-4 relative" {{ block.shopify_attributes }}>
                        {%- if block.settings.heading != blank or block.settings.mark_as_required -%}
                          <label
                            class="pb-2 pt-3 block{% if block.settings.type_field == 'dropdown' or block.settings.type_field == 'text' or block.settings.type_field == 'date' or block.settings.type_field == 'time' %} hidden{% endif %}"
                            for="{{ contact_form }}">
                            {{- block.settings.heading }}
                            {% if block.settings.mark_as_required %}
                              <span aria-hidden="true">*</span>
                            {%- endif %}
                          </label>
                        {%- endif -%}
                        <div class="relative">
                          <select
                            id="{{ contact_form }}"
                            class="w-full pt-3 pb-3 pl-5 md:pt-4 md:pb-3.5 lg:pl-6 pr-8 rtl:pl-8 rtl:lg:pr-6 border focus:outline-none focus:border-current relative cursor-pointer bg-transparent{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                            name="contact[{%- if block.settings.heading != blank -%}{{ block.settings.heading }}{%- else -%}{{ form_item }}{% endif %}]"
                            {% if block.settings.mark_as_required %}
                              required
                            {% endif %}
                            x-init="$watch('requestType', () => { $el.selectedIndex = 0 })"
                          >
                            {%- assign reason_other_label = 'sections.withdrawal_form.reason.other' | t -%}
                            <option class="pt-2.5 pb-2.5 pl-2 pr-2 bg-[rgba(var(--background-color))]" value="{{ reason_other_label }}">
                              {{ reason_other_label }}
                            </option>
                            {%- for key in keys_return -%}
                              {%- assign reason_label = key | prepend: 'sections.withdrawal_form.reason.' | t -%}
                              <option x-show="requestType === 'return'" class="pt-2.5 pb-2.5 pl-2 pr-10 whitespace-normal cursor-pointer bg-[rgba(var(--background-color))]" value="{{ reason_label }}">
                                {{- reason_label -}}
                              </option>
                            {%- endfor -%}
                            {%- for key in keys_cancel -%}
                              {%- assign reason_label = key | prepend: 'sections.withdrawal_form.reason.' | t -%}
                              <option x-show="requestType === 'cancel'" class="pt-2.5 pb-2.5 pl-2 pr-10 whitespace-normal cursor-pointer bg-[rgba(var(--background-color))]" value="{{ reason_label }}">
                                {{- reason_label -}}
                              </option>
                            {%- endfor -%}
                          </select>
                          <span class="absolute top-1/2 -translate-y-1/2 w-2.5 right-4 rtl:left-4 rtl:right-auto cursor-pointer pointer-events-none">{% render 'icon-alls', icon: 'icon-caret' %}</span>
                        </div>
                      </div>
                  {%- endcase -%}
                {%- endfor -%}
              </div>
              <div class="flex flex-col {% if section.settings.button_alignment == 'center' %} items-center{% elsif section.settings.button_alignment == 'left' %} items-left rtl:items-right{% else %} items-right rtl:items-left{% endif %}">
                <div class="mt-3.5 md:mt-5">
                  <button type="submit" class="button button-solid leading-normal pl-8 pr-8 lg:pl-11 lg:pr-11 pt-2.5 pb-2.5 lg:pt-3 lg:pb-3 cursor-pointer empty:hidden pointer-events-auto">
                    {%- if section.settings.button_label != blank -%}
                      {% assign button_label = section.settings.button_label %}
                    {%- else -%}
                      {% assign button_label = 'templates.contact.form.send' | t %}
                    {%- endif -%}
                    {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
                  </button>
                </div>
                {% if section.settings.additional_text != blank %}
                  <div class="rte p-break-words text-[rgb(var(--colors-text))]{% if section.settings.button_alignment == 'center' %} text-center{% elsif section.settings.button_alignment == 'left' %} text-left rtl:text-right{% else %} text-right rtl:text-left{% endif %}">{{ section.settings.additional_text }}</div>
                {% endif %}
              </div>
            {%- endunless -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "t:sections.withdrawal-form.name",
    "disabled_on": {
      "groups": [
        "header",
        "footer",
        "aside"
      ]
    },
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "default": "Get in touch",
        "label": "t:sections.all.text.heading",
        "info": "t:settings_schema.typography.settings.heading_highlight_type.info"
      },
      {
        "type": "select",
        "id": "highlight_type",
        "default": "underline",
        "label": "t:settings_schema.typography.settings.heading_highlight_type.label",
        "options": [
          {
            "value": "underline",
            "label": "t:settings_schema.typography.settings.heading_highlight_type.option__1.label"
          },
          {
            "value": "font_highlight",
            "label": "t:settings_schema.typography.settings.heading_highlight_type.option__3.label"
          }
        ]
      },
      {
        "type": "range",
        "id": "heading_size",
        "min": 50,
        "max": 200,
        "unit": "%",
        "step": 10,
        "default": 100,
        "label": "t:sections.all.text.heading_size"
      },
      {
        "type": "select",
        "id": "heading_tag",
        "default": "h2",
        "label": "t:sections.all.text.heading_tag",
        "options": [
          {
            "value": "h1",
            "label": "H1"
          },
          {
            "value": "h2",
            "label": "H2"
          },
          {
            "value": "h3",
            "label": "H3"
          },
          {
            "value": "h4",
            "label": "H4"
          },
          {
            "value": "h5",
            "label": "H5"
          },
          {
            "value": "h6",
            "label": "H6"
          },
          {
            "value": "p",
            "label": "p"
          }
        ]
      },
      {
        "type": "select",
        "id": "heading_alignment",
        "default": "center",
        "label": "t:sections.all.text.heading_alignment",
        "options": [
          {
            "value": "left",
            "label": "t:sections.all.content_alignment.options__1.label"
          },
          {
            "value": "center",
            "label": "t:sections.all.content_alignment.options__2.label"
          },
          {
            "value": "right",
            "label": "t:sections.all.content_alignment.options__3.label"
          }
        ]
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "t:sections.all.text.text"
      },
      {
        "type": "color",
        "id": "background_color_light",
        "default": "rgba(0,0,0,0)",
        "label": "t:sections.all.background.background_color_light"
      },
      {
        "type": "color",
        "id": "background_color_dark",
        "default": "rgba(0,0,0,0)",
        "label": "t:sections.all.background.background_color_dark"
      },
      {
        "type": "text",
        "id": "button_label",
        "default": "Send",
        "label": "t:sections.all.button.label"
      },
      {
        "type": "select",
        "id": "button_alignment",
        "default": "center",
        "label": "t:sections.all.button.button_alignment",
        "options": [
          {
            "value": "left",
            "label": "t:sections.all.content_alignment.options__1.label"
          },
          {
            "value": "center",
            "label": "t:sections.all.content_alignment.options__2.label"
          },
          {
            "value": "right",
            "label": "t:sections.all.content_alignment.options__3.label"
          }
        ]
      },
      {
        "type": "text",
        "id": "success_message",
        "default": "Your withdrawal request has been submitted successfully. You will receive a confirmation email shortly.",
        "label": "t:sections.featured-product.blocks.back_in_stock_alert.settings.text_success.label"
      },
      {
        "type": "richtext",
        "id": "additional_text",
        "label": "t:sections.testimonials.block_author_note.label"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "checkbox",
        "id": "show_section_divider",
        "default": false,
        "label": "t:sections.all.show_section_divider.label"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "unit": "px",
        "step": 4,
        "default": 28,
        "label": "t:sections.all.padding.padding_top"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "unit": "px",
        "step": 4,
        "default": 28,
        "label": "t:sections.all.padding.padding_bottom"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_layout_mobile"
      },
      {
        "type": "checkbox",
        "id": "show_section_divider_mobile",
        "default": false,
        "label": "t:sections.all.show_section_divider.label"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 100,
        "unit": "px",
        "step": 4,
        "default": 28,
        "label": "t:sections.all.padding.padding_top"
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "unit": "px",
