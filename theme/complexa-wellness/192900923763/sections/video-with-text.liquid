          @media (min-width: 1024px) {
            #x-video-with-text-product-{{ block.id }}-{{ section.id }}.x-splide:not(.disable-effect-hover):hover .splide__arrows .splide__arrow {
              --tw-translate-x: 0rem;
            }
          }
