                            }
                          }
                        {%- endcapture %}
                        {% render 'card-product-quiz', 
                          card_product: product_with_variant,
                          section_id: section.id,
                          product_card_id: product_with_variant.id,
                          index: forloop.index,
                          loading: loading,
                          is_rtl: is_rtl,
                          media_aspect_ratio: settings.product_image_ratio,
                          data_for_customer_event: data_for_customer_event,
                          can_show_preorder: can_show_preorder,
                          message_preorder: message_preorder,
                          disable_cart_edt: disable_cart_edt
                        %}
                      {% endfor %}
                    </div>
                  </div>
                  {% if product_num > 1 %}
                    <div class="items-center w-full gap-5 mt-2.5 md:mt-5 flex{% if product_num <= 3 %} md:hidden{% endif %}">
                      <div class="splide-progress inline-block grow rounded-md">
                        {%- style -%}
                          .splide-progress-bar-variant-{{ section.id }} {
                            width: calc(100% / {{ product_num }});
                          }
                          @media (min-width: 768px) {
                            .splide-progress-bar-variant-{{ section.id }} {
                              width: calc(300% / {{ product_num }});
                            }
                          }
                        {%- endstyle -%}
                        <div class="splide-progress-bar-variant-{{ section.id }} splide-progress-bar rounded-md"></div>
                      </div>
                    </div>
                  {% endif %}
                </div>
                {% assign button_label = 'products.product.add_all_to_cart' | t | append: ' (' | append: product_count | append: ')' %}
                <button id="variant-popup-add-all-{{ section.id }}" x-intersect="checkSelectedVariants($el)" @click="handleAddToCart($el, '.add-all-container-{{ section.id }}' , '.splide__slide:not(.splide__slide--clone) .product-form, #variant-container-{{ section.id }} .card-product form', '{{ settings.name_edt | default: "Note" }}')" class="button button-solid relative w-full disabled:cursor-not-allowed disabled:opacity-30 cursor-pointer pt-3 pb-3 pl-6 pr-6 leading-normal text-center uppercase font-semibold">
                  <span :class="loading && 'invisible'">
                    {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
                  </span>
                  <div x-show="loading" class="w-4 h-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                    {% render 'icon-alls', icon: 'icon-loading' %}
                  </div>
                </button>
              </div>
            </div>
          </div>
        {% endif %}
        <div 
          x-cloak
          id="x-video-with-text-product-{{ block.id }}-{{ section.id }}" 
          class="x-splide splide video-with-text-product-container-{{ section.id }}{% if section.settings.product_layout != 'overlay' %} md:flex md:flex-col md:h-full{% endif %} visible overflow-hidden relative pt-2 pb-2 pl-2 pr-2{% if section.settings.product_layout == 'overlay' %} md:ml-7 md:mr-7 md:pt-7 md:pb-7 md:pl-0 md:pr-0{% else %} md:pt-5 md:pb-5 md:pl-5 md:pr-5 lg:pt-7 lg:pb-7 lg:pl-7 lg:pr-7{% endif %} bg-list-{{ section.id }}"
          x-intersect.once.margin.200px='$store.xSplide.load($el, {
            {% if product_count > 3 -%}
              "type": "loop",
            {%- else -%}
              "type": "slide",
            {%- endif %}
            "videoProduct": true,
            "pagination": false,
            "updateOnMove": "true",
            "speed": 500,
            "perPage": 1,
            "perMove": 1,
            "progressBar": {{ product_count }},
            {% if is_rtl -%}
              "direction": "rtl",
            {%- endif %}
            "mediaQuery": "min",
            "breakpoints": {
              300: {
                "fixedWidth": "80%"
                {% if product_count > 1 -%}
                  ,"gap": 8
                {%- endif %}
              },
              768: {
                {% if section.settings.product_layout == 'overlay' %}
                  "fixedWidth": 400
                  {% if product_count > 1 -%}
                    ,"gap": 16
                  {%- endif %}
                {% else %}
                  "destroy": true
                {% endif %}
              }
            },
            "classes": {
              "arrows": "splide__arrows hidden md:block"
            },
            "events": [
              {
                "event": "ready",
                "callback": () => {
                  document.dispatchEvent(new CustomEvent("eurus:{{ section.id }}:splide-ready"));
                  let slide = $el.querySelector(".splide__list");
                  if (slide) {
                    slide.classList.remove("w-fit", "mr-auto", "ml-auto");
                    if (slide.scrollWidth > slide.clientWidth) {
                      slide.classList.remove("justify-center");
                      $el.querySelector(".splide__arrows").classList.remove("hidden");
                    } else {
                      slide.classList.add("justify-center");
                      $el.querySelector(".splide__arrows").classList.add("hidden");
                    }
                  }
                }
              },
              {
                "event": "resized",
                "callback": () => {
                  let slide = $el.querySelector(".splide__list");
                  if (slide) {
                    if (slide.scrollWidth > slide.clientWidth) {
                      slide.classList.remove("justify-center")
                      $el.querySelector(".splide__arrows").classList.remove("hidden");
                    } else {
                      slide.classList.add("justify-center");
                      $el.querySelector(".splide__arrows").classList.add("hidden");
                    }
                  }
                }
              }
            ]
          });'
          x-intersect.once='$el.classList.add("is-ready-to-animate")'
        >
          <div class="splide__arrows{% if section.settings.product_layout == 'overlay' %} flex{% else %} flex md:hidden{% endif %} items-center">
            <button class="splide__arrow splide__arrow--prev hidden md:block button-arrow pt-3 pb-3 pr-3 pl-3 rounded-full z-10 w-11 h-11 after:text-[20px] rtl:rotate-180 disabled:cursor-not-allowed disabled:opacity-30 absolute top-1/2 -mt-6 left-0 rtl:left-auto rtl:right-0 duration-200 lg:transition-all lg:ease-in-out lg:-translate-x-full rtl:lg:translate-x-full" aria-label="previous slide">
              <span class="hidden">previous slide</span>
              {% render 'icon-labels-bags', icon: 'chevron-left' %}
            </button>
            <button class="splide__arrow splide__arrow--next hidden md:block button-arrow pt-3 pb-3 pr-3 pl-3 rounded-full z-10 w-11 h-11 after:text-[20px] rtl:rotate-180 disabled:cursor-not-allowed disabled:opacity-30 absolute top-1/2 -mt-6 right-0 rtl:right-auto rtl:left-0 duration-200 lg:transition-all lg:ease-in-out lg:translate-x-full rtl:lg:-translate-x-full" aria-label="next slide">
              <span class="hidden">next slide</span>
              {% render 'icon-labels-bags', icon: 'chevron-right' %}
            </button>
          </div>
          <div class="splide__track h-full w-full md:cursor-grab{% if section.settings.product_layout != 'overlay' %} md:h-0 flex-grow md:overflow-y-auto md:max-h-fit scrollbar-body{% endif %}">
            <div class="splide__list flex{% if section.settings.product_layout == 'overlay' %} flex-row{% else %} flex-row md:flex-col md:gap-4 md:justify-start{% endif %} h-full translate-x-0 w-fit mt-auto mb-auto mr-auto ml-auto">
              {% if block.settings.list_products != blank %}
                {% for product in block.settings.list_products %} 
                  {% style %}
                    .x-slide-animation-duration-{{ forloop.index }} {
                      --delay-time: {{ forloop.index0 | times: 100 | append: 'ms' }}
                    }
                  {% endstyle %}
                  <a x-slide-index="{{ forloop.index0 }}" class="{% unless settings.disable_carousel_animation %}x-slide-animation x-slide-animation-duration-{{ forloop.index }}{% endunless %} flex splide__slide x-splide-slide{% if section.settings.product_layout == 'overlay' %} md:w-[400px]{% if product_count > 1 %} mr-4 rtl:ml-4 rtl:mr-0{% endif %}{% else %}{% if product_count > 1 %} mr-4 rtl:ml-4 rtl:mr-0 md:mr-0 rtl:md:ml-0{% endif %}{% endif %} w-full max-w-full justify-center" href="{{ product.url }}">
                    <div class="bg-card-{{ section.id }} items-center flex h-full w-full max-w-full gap-x-2 md:gap-x-4 lg:gap-x-6 pt-2 pb-2 pr-2 pl-2 md:pt-4 md:pb-4 md:pl-4 md:pr-4 lg:pt-6 lg:pb-6 lg:pl-6 lg:pr-6 {% if settings.edges_type == 'rounded_corners' %}rounded-[10px]{% endif %}">
                      {% if product.featured_image != blank %}
                        {% # theme-check-disable ImgLazyLoading %}
                        <img
                          srcset="{{ product.featured_media | image_url: width: 225 }} 225w,
                            {{ product.featured_media | image_url: width: 375 }} 375w,
                            {{ product.featured_media | image_url: width: 450 }} 450w,
                            {{ product.featured_media | image_url: width: 750 }} 750w,
                            {{ product.featured_media | image_url: width: 900 }} 900w,
                            {{ product.featured_media | image_url: width: 1100 }} 1100w,
                            {{ product.featured_media | image_url: width: 1500 }} 1500w
                            {% if product.featured_media.width %},{{ product.featured_media | image_url }} {{ product.featured_media.width }}w{% endif %}" 
                          src="{{ product.featured_media | image_url: width: 1080 }}"
                          alt="{{ product.featured_image.alt | escape }}"  
                          width="{{ product.featured_image.width }}"
                          height="{{ product.featured_image.height }}"
                          loading="{{ loading }}"
                          class="w-[72px] h-[72px] min-w-[72px] min-h-[72px] object-cover {% if settings.edges_type == 'rounded_corners' %}rounded-[10px]{% endif %}"
                        >
                        {% # theme-check-enable ImgLazyLoading %}
                      {% else %}
                        <div class="w-[72px] h-[72px] min-w-[72px] min-h-[72px]">
                          <div class="h-0 w-full relative pb-[100%] overflow-hidden {% if settings.edges_type == 'rounded_corners' %}rounded-[10px]{% endif %}">
                            <div class="bg-[#c9c9c9] flex justify-center absolute top-0 left-0 w-full h-full items-center">
                              {% render 'icon-placeholder', icon: 'icon-product', class: "w-[72px] h-[72px] min-w-[72px] min-h-[72px]" %}
                            </div>
                          </div>
                        </div>
                      {% endif %}
                      <div class="flex flex-col w-1/2 h-fit flex-grow">
                        {%- if block.settings.show_rating -%}
                          {% render 'review-product', product: product, video_with_text: true %}
                        {%- endif -%}
                        <p class="product-title-{{ section.id }} h3 text-[100%] mb-3 p-break-words line-clamp-2 rtl:text-right">{{ product.title }}</p>
                        {% render 'price', product: product, align_left: true %}
                      </div>
                      {% if block.settings.enable_quickview %}
                        <div class="button-quickview-icon z-[15] self-center" x-show="$store.xQuickView && $store.xQuickView.enabled && $store.xQuickView.show_atc_button" x-cloak>
                          <div>
                            {%- capture data_for_customer_event -%}
                              {
                                "product": {
                                  "title": "{{ product.title | escape }}",
                                  "listName": "{{ collection.title | default: '' | escape }}",
                                  "sku": "{{ product.id }}",
                                  "currencyCode": "{{ cart.currency.iso_code }}",
                                  "price": {{ product.price }},
                                  "vendor": "{{ product.vendor | escape }}"
                                }
                              }
                            {%- endcapture %}
                            {% assign product_url = product.url | within: collection | split: "?" | first %}
                            <button
                              @click.prevent='$store.xQuickView && $store.xQuickView.open(); $store.xCustomerEvent.fire("product_selected", $el);' 
                              x-on:mouseover="$store.xQuickView && $store.xQuickView.load('{{ product_url }}', $el, '{{ section.id }}-{{ product.id }}-{{ block.id }}')" 
                              x-on:focus="$store.xQuickView && $store.xQuickView.load('{{ product_url }}', $el, '{{ section.id }}-{{ product.id }}-{{ block.id }}')" 
                              class="button label-btn-quickview button--quickview not-icon leading-normal empty:hidden z-50 h-full md:pt-3 md:pb-3 md:pl-3 md:pr-3 pl-2 pr-2 pb-2 pt-2 rounded-full button-disable-effect"
                              x-customer-event-data="{{ data_for_customer_event | escape }}"
                              aria-label="{{ 'products.product.button_quickview' | t }}"
                            >
                              <span class="w-4 h-4 flex items-center">
                                {%- render 'icon-alls', icon: 'icon-search-quickview' -%}
                              </span>
                            </button>
                          </div>
                        </div>
                      {% endif %}  
                      {% if product.has_only_default_variant %}
                        {% assign product_form_id = 'product-form-' | append: block.id %}
                        {% liquid
                          assign can_show_preorder = false
                          if settings.preorder_show == 'yes' or settings.preorder_show == 'on_backordered' and product.selected_or_first_available_variant.inventory_policy == 'continue' and product.selected_or_first_available_variant.inventory_quantity < 1 and product.selected_or_first_available_variant.inventory_management != nil
                            if settings.applied_products_preorder == blank and settings.applied_collections_preorder == blank
                              assign can_show_preorder = true
                            else 
                              if list_product contains product.id
                                assign can_show_preorder = true
                              else
                                for col in product.collections
                                  if list_collection contains col.id
                                    assign can_show_preorder = true
                                    break
                                  endif
                                endfor
                              endif
                            endif
                          endif 
                          assign disable_cart_edt = false
                          if product.gift_card? or can_show_preorder and settings.hide_when_pre_order
                            assign disable_cart_edt = true
                          endif
                        %}
                        {%- form 'product', product, id: product_form_id, class: 'form h-full product-form hidden', novalidate: 'novalidate', data-type: 'add-to-cart-form', x-ref: 'product_form' -%}
                          <input type="hidden" aria-hidden="true" name="id" class="product-id" value="{{ product.selected_or_first_available_variant.id }}">
                          {% if settings.show_in_cart_items != 'none' %}
                            {% if settings.hide_when_pre_order %}                   
                              <div class="hidden" id="cart-edt-{{ section.id }}">
                                {% if can_show_preorder == false %}
                                  {% render 'estimate-shipping-cart', product: product, message: settings.message_estimate_cart, disable_cart_edt: disable_cart_edt %}
                                {% endif %}
                              </div>
                            {% else %}
                              <div class="hidden" id="cart-edt-{{ section.id }}">
                                {% render 'estimate-shipping-cart', product: product, message: settings.message_estimate_cart, disable_cart_edt: disable_cart_edt %}
                              </div>
                            {% endif %}
                          {% endif %}
                          {% if settings.preorder_show != 'no' %}
                            <div class="hidden" id="preorder-{{ section.id }}">
                              {% if can_show_preorder %}
                                <input name="properties[{{ 'general.preorder.name' | t }}]" aria-label="Preorder" class="hidden preorder-edt-properties" value="{{ message_preorder }}"/>
                              {% endif %}
                            </div>
                          {% endif %}
                        {%- endform -%}
                      {% endif %}
                    </div>
                  </a>
                {% endfor %}
              {% else %}
                {% for i in (1..5) -%}
                  {% style %}
                    .x-slide-animation-duration-{{ forloop.index }} {
                      --delay-time: {{ forloop.index0 | times: 100 | append: 'ms' }}
                    }
                  {% endstyle %}
                  <div x-slide-index="{{ forloop.index0 }}" class="{% unless settings.disable_carousel_animation %}x-slide-animation x-slide-animation-duration-{{ forloop.index }}{% endunless %} flex splide__slide x-splide-slide justify-center">
                    <div class="bg-card-{{ section.id }} flex items-center h-full w-full md:gap-x-5 md:pt-6 md:pb-6 md:pl-6 md:pr-6 pt-2 pb-2 pl-2 pr-2 gap-x-2 {% if settings.edges_type == 'rounded_corners' %}rounded-[10px]{% endif %}">
                      <div class="product-image w-16">
                        <div class='bg-[#c9c9c9] flex justify-center w-full items-center aspect-square{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}'>
                          {%- render 'icon-placeholder', icon: 'icon-product', class: 'w-full h-full' %}
                        </div>
                      </div>
                      <div class="ml-3 rtl:mr-3 rtl:ml-0 flex flex-row flex-1">
                        <div>
                          <h3 class="product-card-heading mb-3 p-break-words leading-tight body-text-base-size">{{ 'onboarding.product_title' | t }}</h3>
                          <div>{% render 'price' %}</div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
          {% unless product_count == 1 %}
            <div class="md:hidden items-center flex w-full gap-5 mt-2 ml-auto mr-auto">
              <div class="splide-progress inline-block grow rounded-md">
                {% style %}
                  .splide-progress-bar-{{ section.id }} {
                    width: {{ 100.0 | divided_by: product_count }}%;
                  }
                  @media (min-width: 768px) {
                    .splide-progress-bar-{{ section.id }} {
                      width: {{ 200.0 | divided_by: product_count }}%;
                    }
                  }
                {% endstyle %}
                <div class="splide-progress-bar-{{ section.id }} splide-progress-bar rounded-md"></div>
              </div>
            </div>
          {% endunless %}
          {% if block.settings.list_products != blank and block.settings.show_add_all %}
            {% assign can_add_all = true %}
            {% for product in block.settings.list_products %}
              {% unless product.available %}
                {% assign can_add_all = false %}
              {% endunless %}
            {% endfor %}
            {% assign button_label = 'products.product.add_all_to_cart' | t | append: ' (' | append: product_count | append: ')' %}
            {% if section.settings.product_layout == 'overlay' %}
              <template x-teleport="#add-all-button-container-{{ section.id }}">
                <button {% unless can_add_all %}disabled :class="{ 'disable-btn-animation': true }"{% endunless %} @click.prevent="{% if products_with_variant != blank %}openVariantContainer(){% else %}handleAddToCart($el, '.add-all-container-{{ section.id }}', '.splide__slide:not(.splide__slide--clone) .product-form', '{{ settings.name_edt | default: "Note" }}'){% endif %}" class="button--{{ section.id }} button button-solid w-full pt-3 pb-3 pl-8 pr-8 z-[15] disabled:cursor-not-allowed disabled:opacity-60">
                  <span :class="{ 'lg:block opacity-0 is-focus-button' : loading }">
                    <span class="flex items-center justify-center gap-3 rtl:flex-row-reverse">
                      <span class="icon-separator-{{ section.id }} inline-block w-9 h-6 min-w-9 min-h-6 border-r rtl:border-l pr-3 rtl:pl-3 rtl:pr-0 rtl:border-r-0">
                        {% render 'icon-labels-bags', icon: 'shopping-bag' %}
                      </span>
                      {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
                    </span>
                  </span>
                  <div class="lg:inline-block w-4 h-4 md:w-5 md:h-5 absolute top-[calc(50%-8px)] left-[calc(50%-8px)] md:top-[calc(50%-10px)] md:left-[calc(50%-10px)]" x-show="loading" x-cloak>
                    {% render 'icon-alls', icon: 'icon-loading' %}
                  </div>
                </button>
              </template>
            {% endif %}
            <div class="{% if section.settings.product_layout == 'overlay' %}md:hidden mt-3 mb-3{% else %} mt-3{% endif %} flex justify-center">
              <button {% unless can_add_all %}disabled :class="{ 'disable-btn-animation': true }"{% endunless %} @click.prevent="{% if products_with_variant != blank %}openVariantContainer(){% else %}handleAddToCart($el, '.add-all-container-{{ section.id }}', '.splide__slide:not(.splide__slide--clone) .product-form', '{{ settings.name_edt | default: "Note" }}'){% endif %}" class="button--{{ section.id }} button button-solid w-fit pt-2 pb-2 pl-4 pr-4 z-[15] disabled:cursor-not-allowed disabled:opacity-60">
                <span :class="{ 'lg:block opacity-0 is-focus-button' : loading }">
                  <span class="flex items-center justify-center gap-3 rtl:flex-row-reverse">
                    <span class="icon-separator-{{ section.id }} inline-block w-9 h-6 min-w-9 min-h-6 border-r rtl:border-l pr-3 rtl:pl-3 rtl:pr-0 rtl:border-r-0">
                      {% render 'icon-labels-bags', icon: 'shopping-bag' %}
                    </span>
                    {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
                  </span>
                </span>
                <div class="lg:inline-block w-4 h-4 md:w-5 md:h-5 absolute top-[calc(50%-8px)] left-[calc(50%-8px)] md:top-[calc(50%-10px)] md:left-[calc(50%-10px)]" x-show="loading" x-cloak>
                  {% render 'icon-alls', icon: 'icon-loading' %}
                </div>
              </button>
            </div>
          {% endif %}  
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% if section.blocks[0].settings.list_products != blank and section.blocks[0].settings.show_add_all %}
  <script src="{{ 'product-list.js' | asset_url }}" defer></script>
{% endif %}
{% schema %}
{
  "name": "t:sections.video_hero.name",
  "tag": "section",
  "class": "section section-video-hero x-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.user_guide_link.section_and_blocks.video_hero"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "t:sections.promotion-banner.settings.show_hero.label",
      "info": "t:sections.promotion-banner.settings.show_hero.info"
    },
    {
      "type": "text",
      "id": "sub_heading_video",
      "label": "t:sections.all.text.subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.text.heading",
      "info": "t:settings_schema.typography.settings.heading_highlight_type.info"
    },
    {
      "type": "select",
      "id": "highlight_type",
      "default": "underline",
      "label": "t:settings_schema.typography.settings.heading_highlight_type.label",
      "options": [
        {
          "value": "underline",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__1.label"
        },
        {
          "value": "font_highlight",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size_video",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "t:sections.all.text.heading_size",
      "default": 100
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h2",
      "label": "t:sections.all.text.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.text.text"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100,
      "label": "t:sections.all.text.text_size"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.all.overlay_opacity.label",
      "default": 0
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.button.label"
    },
    {
      "type": "select",
      "id": "show_button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.primary"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.secondary"
        },
