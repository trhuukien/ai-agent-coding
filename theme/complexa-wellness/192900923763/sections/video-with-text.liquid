                  x-intersect.once.margin.200px='$store.xSplide.load($el, {
                    "speed": 1000,
                    "pagination": false, 
                    "mediaQuery": "min",
                    "updateOnMove": "true",
                    "progressBar": "4",
                    "progressBarHeader": "true",
                    "omitEnd": "true",
                    {%- if is_rtl %} 
                      "direction": "rtl",
                    {%- endif %}
