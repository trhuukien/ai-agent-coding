                {% if block.settings.list_background_color_dark.alpha != 0.0 -%}
                  margin: 0;
                  padding-left: 28px;
                  padding-right: 28px;
                {%- else -%}
                  margin-left: 28px;
                  margin-right: 28px;
                  padding-left: 0;
                  padding-right: 0;
                {%- endif %}
