                  "type": "rich-text",
                  "name": "t:sections.rich-text.name",
                  "settings": {
                    "desktop_width": "100",
                    "mobile_width": "100",
                    "text": "<p><em>\"If I can't explain exactly why an ingredient is in a formula - the mechanism, the dose, the published evidence - it doesn't belong there.\"</em></p>",
