                "rich_text_iGwm8r": {
                  "type": "rich-text",
                  "settings": {
                    "desktop_width": "100",
                    "mobile_width": "100",
                    "text": "<p>Mara completed her PhD in Nutritional Biochemistry at Cornell University and her postdoctoral research at UCL, where she studied adaptogen mechanisms - the system that governs how the body responds to chronic stress. She has spent twelve years watching evidence-backed ingredients get islabelled inside formulas.</p>",
                    "text_size": 100,
                    "content_alignment": "adapt",
                    "mobile_content_alignment": "adapt",
                    "text_color_light": "rgba(0,0,0,0)",
                    "text_color_dark": "rgba(0,0,0,0)"
                  },
                  "blocks": {}
                },
                "rich_text_xxKYDt": {
                  "type": "rich-text",
                  "name": "t:sections.rich-text.name",
                  "settings": {
                    "desktop_width": "100",
                    "mobile_width": "100",
                    "text": "<p>She is the reason Arise publishes full sourcing information for every ingredient. She is also the reason Cycle Support exists.</p>",
                    "text_size": 100,
                    "content_alignment": "adapt",
                    "mobile_content_alignment": "adapt",
                    "text_color_light": "rgba(0,0,0,0)",
                    "text_color_dark": "rgba(0,0,0,0)"
                  },
                  "blocks": {}
                },
