            <div class="grid-quick-access-{{ block_id }} mega-menu-card relative pt-8 pb-3 z-10 w-1/5{% if block.settings.desktop_position == 'right' %} ml-auto rtl:ml-0 order-3 rtl:order-1{% else %} order-1 rtl:order-3 rtl:ml-auto{% endif %}">
              <div class="{%- unless block.settings.color_bg_quick_access.alpha == 0.0 -%} pt-3 pb-3 pl-3 pr-3{% endunless %} w-full button-{{ block_id }} {% if is_rtl %} rtl{% endif %}">
                {%- if block.settings.block_title != blank -%}
                  {% render 'quick-access',
                    block_title: block.settings.block_title,
