                                              show_highlighted_attributes: block.settings.show_highlighted_attributes,
                                              show_rating: block.settings.show_rating
                                              animation_loading: true,
                                              loading: loading
                                            %}
                                          {% endif %}
                                        {%- endfor -%}
                                      </div>
                                    </div>
                                    {%- if enable_slider and grid_items_count > columns_desktop -%}
                                      <div class="lg:flex items-center hidden mt-5 w-3/4 ml-auto mr-auto">
                                        <div class="splide-progress inline-block grow">
                                          <div class="splide-progress-bar" style="width: {{ columns_desktop | times: 100.0 | divided_by: grid_items_count }}%;"></div>
                                        </div>
                                      </div>
                                    {%- endif -%}
                                  </div>
                                </div>
                              </div>
                              {% if block.settings.see_more_link != blank and block.settings.see_more_title != blank %}
