                  --colors-button-hover: rgb({{ block.settings.color_button_hover_dark_quick_access.red }}, {{ block.settings.color_button_hover_dark_quick_access.green }}, {{ block.settings.color_button_hover_dark_quick_access.blue }});
                {%- else -%}
                  --colors-button-hover: rgb({{ settings.colors_dark_button_hover.red }}, {{ settings.colors_dark_button_hover.green }}, {{ settings.colors_dark_button_hover.blue }});
                {%- endunless -%}
