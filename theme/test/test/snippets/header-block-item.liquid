                                  <div class="border-t w-full pt-3 hidden ltr md:flex justify-{{ block.settings.see_more_alignment }} rtl:justify-{% if block.settings.see_more_alignment == 'center' %}center{% elsif block.settings.see_more_alignment == 'start' %}right{% else %}left{% endif %}">
                                    <a href="{{ block.settings.see_more_link }}" class="hover-text-link nav-link relative w-fit flex gap-1{% if is_rtl %} rtl{% endif %}"
                                      {% if block.settings.see_more_open_new_window %} target="_blank" {% endif %}
                                    >
                                      {{ block.settings.see_more_title }}
                                      <span class="block w-5 h-5 rtl:rotate-180">{% render 'icon-alls', icon: 'icon-arrow' %}</span>
                                    </a>
                                  </div>
                                </div>
                              {% endif %}
                            </div>
                          </div>
                        {% else %}
                          {% if block.settings.see_more_link != blank and block.settings.see_more_title != blank %}
                            <div class="toggle-menu-sub overflow-hidden pl-7 xl:pr-5{% if forloop.first %} open{% endif %} toggle-menu-sub-hidden">   
                              <div class="{% if is_rtl %} pl-0{% else %} pr-0{% endif %} relative scrollbar-body scrollbar-visible ltr pb-8 x-pgw page-width mr-auto ml-auto">
                                <div class="mega-sub-nav pr-5 pt-4 pb-4 hidden md:block">
                                  <div class="border-t w-full pt-3 hidden ltr md:flex justify-{{ block.settings.see_more_alignment }} rtl:justify-{% if block.settings.see_more_alignment == 'center' %}center{% elsif block.settings.see_more_alignment == 'start' %}right{% else %}left{% endif %}">
                                    <a href="{{ block.settings.see_more_link }}" class="hover-text-link nav-link relative w-fit flex gap-1{% if is_rtl %} rtl{% endif %}"
                                      {% if block.settings.see_more_open_new_window %} target="_blank" {% endif %}
                                    >
                                      {{ block.settings.see_more_title }}
                                      <span class="block w-5 h-5 rtl:rotate-180">{% render 'icon-alls', icon: 'icon-arrow' %}</span>
                                    </a>
                                  </div>
                                </div>
                              </div>
                            </div>
                          {% endif %}
                        {%- endif -%}
                      </li>
                    {% endcapture %}
                    {% assign sub_menu_items = sub_menu_items | append: sub_menu_item %}
                  {%- endfor -%}
                </div>
                <ul class="pb-8 relative items-end flex-wrap md:max-h-[calc(80vh-3rem)] md:overflow-y-auto scrollbar-body scrollbar-visible">
                  {{ sub_menu_items }}
                </ul>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </template>
  {%- when 'simple_menu'-%}
    {%- liquid 
      assign image_count = 0
      if block.settings.image_1 != blank
        assign image_count = image_count | plus: 1
      endif
      if block.settings.image_2 != blank
        assign image_count = image_count | plus: 1
      endif
      if block.settings.image_3 != blank
        assign image_count = image_count | plus: 1
      endif
      assign quick_access_count = 0
      if block.settings.enable_quick_access_blocks
        if block.settings.block_title != blank
          assign quick_access_count = 1
        elsif block.settings.block_title_2 != blank
          assign quick_access_count = 1
        elsif block.settings.block_title_3 != blank
          assign quick_access_count = 1
        elsif block.settings.block_title_4 != blank
          assign quick_access_count = 1
        endif
      endif 
      assign image_count = image_count | plus: quick_access_count
      assign total_block = image_count | minus: quick_access_count
      assign class_menu_width = 'w-full'
      if image_count > 0
        assign class_image_width = 'w-1/5'
        if total_block > 0 and quick_access_count > 0
          assign class_menu_width = 'md:w-3/5 grid-cols-3'
        else 
          assign class_menu_width = 'w-4/5'
        endif
        if block.settings.promotion_layout == 'horizontal'
         if image_count >= 2 and quick_access_count == 0
            assign class_image_width = 'w-1/2'
            assign class_menu_width = 'w-1/2'
         endif
         if image_count >= 3 and quick_access_count > 0
            assign class_image_width = 'w-7/12'
            assign class_menu_width = 'w-5/12 2xl:w-[38.75%] grid-cols-2'
          endif
        endif
      endif
      assign multiple_menu = false
      assign childlink_links_count = block.settings.menu.links | map: 'links' | compact | size
      if childlink_links_count > 0
        assign multiple_menu = true
      endif
      assign promotion_position = block.settings.promotion_position
      if is_rtl
        if promotion_position == 'left'
          assign promotion_position = 'right'
        elsif promotion_position == 'right'
          assign promotion_position = 'left'
        endif
      endif
    -%}
    <template x-if="!$store.xInit.runDispatch"> 
      <div 
        id="menu-{{ index }}" 
        :class="{ 'toggle-menu-hidden': $store.xHeaderMenu.show !== {{ index }}, 'toggle-menu-show': $store.xHeaderMenu.show === {{ index }}, 'active': $store.xHeaderMenu.initIndex.has({{ index }}) }" 
        class="toggle-menu top-full text-[rgba(var(--colors-text))] mega-menu-horizontal{% if image_count > 0 %} main-nav-child-{{ promotion_position }}{% endif %} is-focus:text-[rgba(var(--colors-text))] absolute w-full background-header left-0 z-50 shadow-md ltr"
      >
        <div class="toggle-menu-child x-pgw page-width mr-auto ml-auto{% if image_count > 0 %} flex promotion-{{ block.settings.promotion_layout }} image-count-{{ total_block }}{% else %} mega-menu-container{% endif %}{% if quick_access_count > 0 %} flex gap-5 xl:gap-8{% endif %}">
          {%- if block.settings.menu != blank -%}
            <ul class="mega-nav md:max-h-[calc(80vh-4rem)] justify-{{ block.settings.menu_content_alignment }} order-2 scrollbar-body scrollbar-visible flex-wrap relative gap-5 xl:gap-8 flex pt-7 pb-8 flex-row z-50 left-0 right-0 {{ class_menu_width }} top-full{% if is_rtl %} rtl{% endif %}">
              {%- style -%}
                {%- if block.settings.sub_label != blank -%}
                  .color-sub-label-{{ block.id }} {
                    background: {{ block.settings.sub_label_color }};
                    color: {{ block.settings.sub_label_text_color_light }};
                  }
                  .color-sub-label-{{ block.id }}:before{
                    border-top-color: {{ block.settings.sub_label_color }}; 
                  }
                  .dark .color-sub-label-{{ block.id }} {
                    background: {{ block.settings.sub_label_color_dark }};
                    color: {{ block.settings.sub_label_text_color_dark }}
                  }
                  .dark .color-sub-label-{{ block.id }}:before {
                    border-top-color: {{ block.settings.sub_label_color_dark }};
                  }
                {% endif %}
              {%- endstyle -%}
              {%- for childlink in block.settings.menu.links -%}
                <li class="relative w-col-menu">
                  <div class="{% if menu_font_weight < 600 and multiple_menu == true %}font-semibold{% endif %}">
                    {% liquid 
                      assign show_image = false
                      if childlink.type == 'product_link' and block.settings.show_image_product
                        assign show_image = true
                      endif
                      if childlink.type == 'collection_link' and block.settings.show_image_collection
                        assign show_image = true
                      endif
                    %}
                    {% if show_image %}
                      {%- render 'menu-item-image', link: childlink, show_first_image_product: block.settings.show_first_image_product, image_ratio: block.settings.image_ratio, column: column, collection_metafield: block.settings.collection_metafield -%}
                    {% endif %}
                    <a href="{{ childlink.url }}" class="flex flex-wrap gap-2 nav-link relative transition duration-200 p-break-words hover-text-link{% if childlink.current %} flex border-b effect-inline{% else %} inline-block{%- endif -%}{% if childlink.links != blank %} mb-3{% endif %}">
                      {% liquid
                        assign is_labeled = false
                        assign menu_item = '||' | append: childlink.title | append: '||' | escape
                        if list_sub_menu contains menu_item
                          assign is_labeled = true
                        endif
                      %}
                      {% assign title = childlink.title %}
                      {% if section.settings.enable_highlight %}
                        {% liquid
                          assign is_highlight = false
                          assign menu_item = '||' | append: title | append: '||' | escape
                          if list_menu contains menu_item
                            assign is_highlight = true
                          endif
                        %}
                        {% if is_highlight %}
                          {% render 'menu-highlight',
                            highlight_type: section.settings.highlight_style,
                            menu_title: title,
                            section_id: section.id,
                          %}
                        {% else %}
                          <span class="p-break-words">{{ title | escape }}</span>
                        {% endif %}
                      {% else %}
                        <span class="p-break-words">{{ title | escape }}</span>
                      {% endif %}
                      {% if is_labeled %}
                        {{ sub_label }}
                      {% endif %}
                    </a>
                  </div>
                  {%- if childlink.links != blank -%}
                    <ul class="list-unstyled{% if is_rtl %} rtl{% endif %}" role="list">
                      {%- for grandchildlink in childlink.links -%}
                        <li class="flex items-center pt-1.5 pb-1.5 relative font-normal font_menu-normal">
                          {% liquid 
                            assign show_image = false
                            if grandchildlink.type == 'product_link' and block.settings.show_sub_image_product
                              assign show_image = true
                            endif
                            if grandchildlink.type == 'collection_link' and block.settings.show_sub_image_collection
                              assign show_image = true
                            endif
                          %}
                          {% if show_image %}
                            {%- render 'menu-item-image', link: grandchildlink, show_first_image_product: block.settings.show_sub_first_image_product, class_ratio: class_image_ratio, image_left: true, collection_metafield: block.settings.collection_metafield -%}
                          {% endif %}
                          <span class="flex-1">
                            <a href="{{ grandchildlink.url }}" class="flex flex-wrap gap-2 nav-link relative transition duration-200 p-break-words hover-text-link{% if grandchildlink.current %} flex effect-inline border-b{% else %} inline-block{% endif %}">
                              {% liquid
                                assign is_labeled = false
                                assign menu_item = '||' | append: grandchildlink.title | append: '||' | escape
                                if list_sub_menu contains menu_item
                                  assign is_labeled = true
                                endif
                              %}
                              {% assign title = grandchildlink.title %}
                              {% if section.settings.enable_highlight %}
                                {% liquid
                                  assign is_highlight = false
                                  assign menu_item = '||' | append: title | append: '||' | escape
                                  if list_menu contains menu_item
                                    assign is_highlight = true
                                  endif
                                %}
                                {% if is_highlight %}
                                  {% render 'menu-highlight',
                                    highlight_type: section.settings.highlight_style,
                                    menu_title: title,
                                    section_id: section.id,
                                  %}
                                {% else %}
                                  <span class="p-break-words">{{ title | escape }}</span>
                                {% endif %}
                              {% else %}
                                <span class="p-break-words">{{ title | escape }}</span>
                              {% endif %}
                              {% if is_labeled %}
                                {{ sub_label }}
                              {% endif %}
                            </a>
                          </span>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if block.settings.enable_quick_access_blocks and quick_access_count > 0 -%}
