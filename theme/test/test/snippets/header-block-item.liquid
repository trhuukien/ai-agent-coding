            @focusout="openSub = false; $el.classList.remove('is-focus-child');"
          >
            <div class="flex tree-menu-item-container items-center{% unless forloop.first %} pt-3{% endunless %}">
              {% liquid 
                assign show_image = false
                if link.type == 'product_link' and block.settings.show_image_product
                  assign show_image = true
