                                                menu_title: title,
                                                section_id: section.id,
                                              %}
                                            {% else %}
                                              <span class="p-break-words">{{ title | escape }}</span>
                                            {% endif %}
                                          {% else %}
                                            <span class="p-break-words">{{ title | escape }}</span>
                                          {% endif %}
                                          {% if is_labeled %}
                                            {{ sub_label }}
                                          {% endif %}
                                        </a>
                                        {% liquid 
                                          assign show_image = false
                                          if childlink.type == 'product_link' and block.settings.show_sub_image_product
                                            assign show_image = true
                                          endif
                                          if childlink.type == 'collection_link' and block.settings.show_sub_image_collection
                                            assign show_image = true
                                          endif
                                        %}
                                        {% if show_image %}
                                          {%- render 'menu-item-image', link: childlink, show_first_image_product: block.settings.show_sub_first_image_product, image_ratio: block.settings.image_ratio, column: column, collection_metafield: block.settings.collection_metafield -%}
                                        {% endif %}
                                      </div>
                                      {%- if childlink.links != blank -%}
                                        <ul class="list-unstyled" role="list">
                                          {%- for grandchildlink in childlink.links -%}
                                            <li class="flex items-center pt-1.5 pb-1.5 relative font-normal">
                                              <span class="flex-1">
                                                <a href="{{ grandchildlink.url }}" class="flex flex-wrap gap-2 nav-link relative transition duration-200 p-break-words hover-text-link{% if grandchildlink.current %} flex effect-inline border-b{% else %} inline-block{% endif %}">
                                                  {% liquid
                                                    assign is_labeled = false
                                                    assign menu_item = '||' | append: grandchildlink.title | append: '||' | escape
                                                    if list_sub_menu contains menu_item
                                                      assign is_labeled = true
                                                    endif
                                                  %}
                                                  {% assign title = grandchildlink.title %}
                                                  {% if section.settings.enable_highlight %}
                                                    {% liquid
                                                      assign is_highlight = false
                                                      assign menu_item = '||' | append: title | append: '||' | escape
                                                      if list_menu contains menu_item
                                                        assign is_highlight = true
                                                      endif
                                                    %}
                                                    {% if is_highlight %}
                                                      {% render 'menu-highlight',
                                                        highlight_type: section.settings.highlight_style,
                                                        menu_title: title,
                                                        section_id: section.id,
                                                      %}
                                                    {% else %}
                                                      <span class="p-break-words">{{ title | escape }}</span>
                                                    {% endif %}
                                                  {% else %}
                                                    <span class="p-break-words">{{ title | escape }}</span>
                                                  {% endif %}
                                                  {% if is_labeled %}
                                                    {{ sub_label }}
                                                  {% endif %}
                                                </a>
                                              </span>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      {%- endif -%}
