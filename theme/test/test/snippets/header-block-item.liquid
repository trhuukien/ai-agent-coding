{% liquid 
  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
    assign class_image_ratio = "w-8 h-8 ml-4"
  else
    assign is_rtl = false
    assign class_image_ratio = "w-8 h-8 mr-4"
  endif
  assign text_base_size = settings.text_base_size | times: 0.01
  assign menu_font_weight = settings.type_menu_font.weight | plus: 0
  if section.settings.enable_highlight
    assign menus = section.settings.menus | newline_to_br | strip_newlines | split: '<br />'
    assign list_menu = menus | join: '||' | prepend: '||' | append: '||' | escape
  endif
  assign sub_menus = block.settings.applied_sub_menus | newline_to_br | strip_newlines | split: '<br />'
  assign list_sub_menu = sub_menus | join: '||' | prepend: '||' | append: '||' | escape
%}
{% capture sub_label %}
  {%- if block.settings.sub_label != blank -%}
    <div class="color-sub-label-{{ block.id }} z-10 min-w-[40px] flex items-center -right-1.5 bottom-[85%] {% if settings.edges_type == "rounded_corners" %}rounded-[4px]{% endif %} shadow-md pl-2 pr-2 pt-0.5 pb-0.5 text-[10px]">
      {% if block.settings.sub_icon != 'none' %}
        {% unless block.settings.sub_custom_icon == blank and block.settings.sub_another_icon == blank and block.settings.sub_icon == 'another_icon' %}
          <span class="w-3 h-3{% if is_rtl %} ml-1{% else %} mr-1{% endif %}">
            {% if block.settings.sub_custom_icon == blank %}
              {% if block.settings.sub_another_icon != blank and block.settings.sub_icon == 'another_icon' %}
                {% render 'icon-new-alls', icon: block.settings.sub_another_icon %}
              {% else %}
                {% render 'icon-labels-bags', icon: block.settings.sub_icon %}
              {% endif %}
            {% else %}
              {{ block.settings.sub_custom_icon }}
            {% endif %}
          </span>
        {% endunless %}
      {%- endif -%}                
      <span>{{ block.settings.sub_label }}</span>
    </div>
  {%- endif -%}
{% endcapture %}
{%- case type_menu -%}
  {%- when 'tabbed_menu' -%}
    {%- liquid
      assign image_count = 0
      if block.settings.image_1 != blank
        assign image_count = image_count | plus: 1
      endif
      if block.settings.image_2 != blank
        assign image_count = image_count | plus: 1
      endif
      if block.settings.image_3 != blank
        assign image_count = image_count | plus: 1
      endif
      assign quick_access_count = 0
      if block.settings.enable_quick_access_blocks
        if block.settings.block_title != blank
          assign quick_access_count = 1
        elsif block.settings.block_title_2 != blank
          assign quick_access_count = 1
        elsif block.settings.block_title_3 != blank
          assign quick_access_count = 1
        elsif block.settings.block_title_4 != blank
          assign quick_access_count = 1
        endif
      endif 
      assign image_count = image_count | plus: quick_access_count
      assign total_block = image_count | minus: quick_access_count
      if image_count > 0
        assign class_image_width = 'w-1/5'
        if total_block > 0 and quick_access_count > 0
          assign class_menu = 'md:w-3/5 grid-cols-3'
        else 
          assign class_menu = 'w-3/4 grid-cols-3'
        endif
        if block.settings.promotion_layout == 'horizontal'
          assign class_image_width = 'w-1/5'
          if total_block > 0 and quick_access_count > 0
            assign class_menu = 'w-3/5 grid-cols-3'
          endif
          if total_block == 2
            assign class_image_width = 'w-1/2'
            assign class_menu = 'w-1/2 2xl:w-5/12 grid-cols-2'
          elsif total_block >= 3
            assign class_image_width = 'w-7/12'
            unless block.settings.tab_style == "vertical" and block.settings.enable_quick_access_blocks == true
              assign class_menu = 'w-5/12 2xl:w-[38.75%] grid-cols-2'
            else
              assign class_menu = 'w-5/12 2xl:w-[38.75%] grid-cols-1'
            endunless
          endif
        endif
      else
        assign class_menu = 'grid-cols-4'
      endif
      assign promotion_position = block.settings.promotion_position
      if is_rtl
        if promotion_position == 'left'
          assign promotion_position = 'right'
        elsif promotion_position == 'right'
          assign promotion_position = 'left'
        endif
      endif
    -%}
    {%- if block.settings.menu.links or image_count > 0 -%}
      <template x-if="!$store.xInit.runDispatch">
        <div 
          :class="{ 'toggle-menu-hidden': $store.xHeaderMenu.show !== {{ index }}, 'toggle-menu-show': $store.xHeaderMenu.show === {{ index }}, 'active': $store.xHeaderMenu.initIndex.has({{ index }}) }" 
          id="menu-{{ index }}" 
          class="toggle-menu top-full background-header is-focus:text-[rgba(var(--colors-text))] text-[rgba(var(--colors-text))] absolute w-full background-header left-0 z-50 shadow-md ltr
          {%- if quick_access_count == 0 or total_block == 0 %} mega-menu-{{ block.settings.tab_style }}{% endif -%}
          {%- if image_count > 0 and quick_access_count <= 0 %} main-nav-child-{{ promotion_position }}{% endif %}"
        >
          <div x-intersect.once.full="$store.xHeaderMenu.updateHeight($el, 'menu-{{ index }}')" class="mega-menu-container toggle-menu-child x-pgw page-width mr-auto ml-auto promotion-{{ block.settings.promotion_layout }} image-count-{{ image_count }} md:max-h-[80vh]{% if quick_access_count > 0 %} flex gap-5 xl:gap-8{% endif %}">
            <div class="mega-nav pt-8  pb-8 overflow-hidden relative{% if block.settings.tab_style == 'vertical' %}{% if is_rtl %} rtl{% endif %}{% else %} flex flex-col{% endif %} {{ class_menu }} {% if quick_access_count > 0 %} order-2{% endif %} mega-menu-{{ block.settings.tab_style }}">
              {%- if block.settings.sub_label != blank -%}
                {%- style -%}
                  .color-sub-label-{{ block.id }} {
                    background: {{ block.settings.sub_label_color }};
                    color: {{ block.settings.sub_label_text_color_light }};
                  }
                  .color-sub-label-{{ block.id }}:before{
                    border-top-color: {{ block.settings.sub_label_color }}; 
                  }
                  .dark .color-sub-label-{{ block.id }} {
                    background: {{ block.settings.sub_label_color_dark }};
                    color: {{ block.settings.sub_label_text_color_dark }}
                  }
                  .dark .color-sub-label-{{ block.id }}:before {
                    border-top-color: {{ block.settings.sub_label_color_dark }};
                  }
                {%- endstyle -%}
              {% endif %}
              {% if block.settings.tab_style == 'vertical' %}
                {% assign block_id_downcase = block.id | replace: "_", "" | downcase %}
                {% style %}
                  .grid-cols-{{ block.id }} {
                    grid-template-columns: auto 1fr;
                  }
                {% endstyle %}
                <div class="mega-list-nav grid grid-cols-{{ block.id }} items-start w-full{% if is_rtl %} rtl justify-start{% endif %}" x-refs="mega_nav"> 
                  <div class="md:max-h-[calc(80vh-3rem)] md:overflow-y-auto scrollbar-body flex flex-col w-72">
                    {% assign sub_menu_items = '' %}
                    {%- for link in block.settings.menu.links -%}
                      <div 
                        class="sub-menu flex items-center z-10 relative pl-2.5 pr-2.5 w-[15.6rem]{% if is_rtl %} rtl{% endif %}{% if forloop.first %}  border-t{% endif %}"
                        {% if forloop.first %}
                          x-intersect.once="$store.xHeaderMenu.openSubMenu('{{ block_id_downcase }}', '{{ forloop.index }}');"
                        {% endif %}
                        :class="$store.xHeaderMenu.subShow.get('{{ block_id_downcase }}') === '{{ forloop.index }}' && 'active'"
                        @mouseover="$dispatch('mouseover-{{ block_id_downcase }}-{{ forloop.index }}'); $el.classList.add('is-focus-child')"
                        @mouseleave="$el.classList.remove('is-focus-child')"
                        @focusin="$dispatch('focusin-{{ block_id_downcase }}-{{ forloop.index }}'); $el.classList.add('is-focus-child')"
                        @focusout="$el.classList.remove('is-focus-child')"
                      >
                        {% liquid 
                          assign show_image = false
                          if link.type == 'product_link' and block.settings.show_image_product
                            assign show_image = true
                          endif
                          if link.type == 'collection_link' and block.settings.show_image_collection
                            assign show_image = true
                          endif
                        %}
                        {% if show_image %}
                          {%- render 'menu-item-image', link: link, show_first_image_product: block.settings.show_first_image_product, class_ratio: class_image_ratio, image_left: true, collection_metafield: block.settings.collection_metafield -%}
                        {% endif %}
                        <span class="flex-1">
                          <a
                            href="{{ link.url }}"
                            class="nav-link p-break-words z-10 pt-3 pb-3 flex flex-wrap gap-2 items-center{% if link.links != blank %} pr-5 rtl:pr-0 rtl:pl-5{% endif %} hover-text-link is-focus-child:effect-inline{%- if link.current or link.child_active %} flex effect-inline{% endif %}"
                            {% if link.links != blank %}@init-run.window="$store.xHeaderMenu.isTouch && $store.xHeaderMenu.touchItem($el, true, {{ forloop.index }})"{% endif %}
                          >
                            {% liquid
                              assign is_labeled = false
                              assign menu_item = '||' | append: link.title | append: '||' | escape
                              if list_sub_menu contains menu_item
                                assign is_labeled = true
                              endif
                            %}
                            {% assign title = link.title %}
                            {% if section.settings.enable_highlight %}
                              {% liquid
                                assign is_highlight = false
                                assign menu_item = '||' | append: title | append: '||' | escape
                                if list_menu contains menu_item
                                  assign is_highlight = true
                                endif
                              %}
                              {% if is_highlight %}
                                {% render 'menu-highlight',
                                  highlight_type: section.settings.highlight_style,
                                  menu_title: title,
                                  section_id: section.id,
                                %}
                              {% else %}
                                <span class="p-break-words">{{ title | escape }}</span>
                              {% endif %}
                            {% else %}
                              <span class="p-break-words">{{ title | escape }}</span>
                            {% endif %}
                            {% if is_labeled %}
                              {{ sub_label }}
                            {% endif %}
                            {%- if link.links != blank -%}
                              <span class="z-10 w-5 h-4 pt-1 pb-1 pl-1 pr-1 rounded-full block absolute -rotate-90 rtl:rotate-90 right-1.5 rtl:right-auto rtl:left-1.5">
                                {% render 'icon-alls', icon: 'icon-caret' %}
                              </span>
                            {%- endif -%}
                          </a>
                        </span>
                      </div>
                      {% capture sub_menu_item %}
                        <li
                          class="sub-menu-item{% if link.links != blank %} has-dropdown{% endif %} tabbed-animation-change"
                          {% if forloop.first %}
                            x-intersect.once="$store.xHeaderMenu.openSubMenu('{{ block_id_downcase }}', '{{ forloop.index }}');"
                          {% endif %}
                          :class="$store.xHeaderMenu.subShow.get('{{ block_id_downcase }}') === '{{ forloop.index }}' && 'is-active'"
                          @mouseover-{{ block_id_downcase }}-{{ forloop.index }}.window="$store.xHeaderMenu.openSubMenu('{{ block_id_downcase }}', '{{ forloop.index }}'); $el.classList.add('is-focus-child');"
                          @mouseleave="$el.classList.remove('is-focus-child');"
                          @focusin-{{ block_id_downcase }}-{{ forloop.index }}.window="$store.xHeaderMenu.openSubMenu('{{ block_id_downcase }}', '{{ forloop.index }}'); $el.classList.add('is-focus-child');"
                          @focusout="$el.classList.remove('is-focus-child');"
                          {%- if link.current or link.child_active %}@init-run.window="active = true;"{% endif %}
                        >
                          {% liquid
                            assign column = 4
                            if block.settings.promotion_layout == 'vertical'
                              if link.links.size < 4
                                if link.links.size > 1
                                  assign column = link.links.size
                                else
                                  assign column = 2
                                endif
                              endif
                              assign class_menu = 'w-full grid-cols-' | append: column
                            endif
                            assign class_menu = class_menu | remove: 'w-3/4 ' | remove: '2xl:w-3/5 ' | remove: 'w-1/2 2xl:w-5/12 ' | remove: 'w-5/12 2xl:w-[38.75%] ' | remove: '2xl:w-[62%] ' | remove: 'w-4/5 ' | append: ' w-full'

                            assign multiple_menu = false
                            assign childlink_links_count = link.links | map: 'links' | compact | size
                            if childlink_links_count > 0
                              assign multiple_menu = true
                            endif
                          %}
                          <div class="toggle-menu-sub overflow-hidden relative h-auto ltr">   
                            <div class="relative x-pgw page-width mr-auto ml-auto">
                              {%- if link.links != blank -%}
                                <ul class="sub-menu-container order-2 flex flex-wrap justify-{{ block.settings.menu_content_alignment }} gap-y-7 gap-x-7 h-full{% if is_rtl %} rtl{% endif %}">
                                  {%- for childlink in link.links -%}
                                    <li class="relative w-24 lg:w-48">
                                      <div class="{% if menu_font_weight < 600 and multiple_menu == true %}font-semibold{% endif %}">
                                        <a href="{{ childlink.url }}" class="flex flex-wrap gap-2 nav-link relative transition duration-200 mb-2 p-break-words hover-text-link{% if childlink.current %} flex border-b effect-inline{% else %} inline-block{%- endif -%}">
                                          {% liquid
                                            assign is_labeled = false
                                            assign menu_item = '||' | append: childlink.title | append: '||' | escape
                                            if list_sub_menu contains menu_item
                                              assign is_labeled = true
                                            endif
                                          %}
                                          {% assign title = childlink.title %}
                                          {% if section.settings.enable_highlight %}
                                            {% liquid
                                              assign is_highlight = false
                                              assign menu_item = '||' | append: title | append: '||' | escape
                                              if list_menu contains menu_item
                                                assign is_highlight = true
                                              endif
                                            %}
                                            {% if is_highlight %}
                                              {% render 'menu-highlight',
                                                highlight_type: section.settings.highlight_style,
                                                menu_title: title,
                                                section_id: section.id,
                                              %}
                                            {% else %}
                                              <span class="p-break-words">{{ title | escape }}</span>
                                            {% endif %}
                                          {% else %}
                                            <span class="p-break-words">{{ title | escape }}</span>
                                          {% endif %}
                                          {% if is_labeled %}
                                            {{ sub_label }}
                                          {% endif %}
                                        </a>
                                        {% liquid 
                                          assign show_image = false
                                          if childlink.type == 'product_link' and block.settings.show_sub_image_product
                                            assign show_image = true
                                          endif
                                          if childlink.type == 'collection_link' and block.settings.show_sub_image_collection
                                            assign show_image = true
                                          endif
                                        %}
                                        {% if show_image %}
                                          {%- render 'menu-item-image', link: childlink, show_first_image_product: block.settings.show_sub_first_image_product, image_ratio: block.settings.image_ratio, column: column, collection_metafield: block.settings.collection_metafield -%}
                                        {% endif %}
                                      </div>
                                      {%- if childlink.links != blank -%}
                                        <ul class="list-unstyled" role="list">
                                          {%- for grandchildlink in childlink.links -%}
                                            <li class="flex items-center pt-1.5 pb-1.5 relative font-normal">
                                              <span class="flex-1">
                                                <a href="{{ grandchildlink.url }}" class="flex flex-wrap gap-2 nav-link relative transition duration-200 p-break-words hover-text-link{% if grandchildlink.current %} flex effect-inline border-b{% else %} inline-block{% endif %}">
                                                  {% liquid
                                                    assign is_labeled = false
                                                    assign menu_item = '||' | append: grandchildlink.title | append: '||' | escape
                                                    if list_sub_menu contains menu_item
                                                      assign is_labeled = true
                                                    endif
                                                  %}
                                                  {% assign title = grandchildlink.title %}
                                                  {% if section.settings.enable_highlight %}
                                                    {% liquid
                                                      assign is_highlight = false
                                                      assign menu_item = '||' | append: title | append: '||' | escape
                                                      if list_menu contains menu_item
                                                        assign is_highlight = true
                                                      endif
                                                    %}
                                                    {% if is_highlight %}
                                                      {% render 'menu-highlight',
                                                        highlight_type: section.settings.highlight_style,
                                                        menu_title: title,
                                                        section_id: section.id,
                                                      %}
                                                    {% else %}
                                                      <span class="p-break-words">{{ title | escape }}</span>
                                                    {% endif %}
                                                  {% else %}
                                                    <span class="p-break-words">{{ title | escape }}</span>
                                                  {% endif %}
                                                  {% if is_labeled %}
                                                    {{ sub_label }}
                                                  {% endif %}
                                                </a>
                                              </span>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      {%- endif -%}
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                            </div>
                            {% if block.settings.see_more_link != blank and block.settings.see_more_title != blank %}
                              <div class="mega-sub-container relative x-pgw page-width mr-auto ml-auto clear-both"
                                style="padding-top: 0{% if is_rtl %}; padding-left: 5rem{% endif %}"
                              >
                                <div class="mega-sub-nav pr-5 pb-8 {{ class_menu }}">
                                  <div class="see-more{% if link.links != blank %} border-t{% endif %} pt-4 pb-4 hidden ltr md:flex justify-{{ block.settings.see_more_alignment }} rtl:justify-{% if block.settings.see_more_alignment == 'center' %}center{% elsif block.settings.see_more_alignment == 'start' %}right{% else %}left{% endif %}">
                                    <a href="{{ block.settings.see_more_link }}" 
                                      class="hover-text-link nav-link relative w-fit flex gap-1{% if is_rtl %} rtl{% endif %}"
                                      {% if block.settings.see_more_open_new_window %} target="_blank" {% endif %}
                                    >
                                      {{ block.settings.see_more_title }}
                                      <span class="block w-5 h-5 rtl:rotate-180">{% render 'icon-alls', icon: 'icon-arrow' %}</span>
                                    </a>
                                  </div>
                                </div>
                              </div>
                            {% endif %}
                          </div>
                        </li>
                      {% endcapture %}
                      {% assign sub_menu_items = sub_menu_items | append: sub_menu_item %}
                    {%- endfor -%}
                  </div>
                  <ul class="md:max-h-[calc(80vh-3rem)] md:overflow-y-scroll scrollbar-body scrollbar-visible">
                    {{ sub_menu_items }}
                  </ul>
                </div>
              {% else %}
                <div class="x-splide splide flex gap-x-8 disable-effect-hover visible"
                  id="horizontal-menu-{{ block.id }}"
                  x-intersect.once.margin.200px='$store.xSplide.load($el, {
                    "speed": 1000,
                    "pagination": false, 
                    "updateOnMove": "true",
                    "autoWidth": "true",
                    "gap": "2rem",
                    {%- if is_rtl %} 
                    "direction": "rtl",
                    {%- endif %}
                    "focus": "right",
                    "perPage": 1,
                    "perMove": 2,
                    "events": [
                      {
                        "event": "ready",
                        "callback": () => {
                          let slide = document.getElementById("horizontal-menu-{{ block.id }}");
                          let slideList = slide.querySelector(".splide__list");
                          let btnArrow = slide.querySelector(".splide__arrows"); 
                          if (slide.offsetWidth <= slideList.offsetWidth) {
                            btnArrow.classList.remove("md:hidden");
                          } else {
                            btnArrow.classList.add("md:hidden");
                          }
                        }
                      }
                    ]
                  })'
                >
                  <div class="absolute top-1/2 splide__arrows md:hidden flex justify-center w-full items-center">
                    <button class="splide__arrow splide__arrow--prev button-arrow lg:absolute top-1/2 -translate-y-1/2 left-0 rtl:left-auto rtl:right-0 rtl:rotate-180 pl-2 pr-2 pt-2 pb-2 rounded-full z-10 w-7 h-7 after:text-[20px] duration-200 hover:opacity-100 disabled:cursor-not-allowed disabled:hidden transition-all ease-in-out disabled:opacity-30" aria-label="previous slide">
                      {% render 'icon-labels-bags', icon: 'chevron-left' %}
                    </button>
                    <button class="splide__arrow splide__arrow--next button-arrow lg:absolute top-1/2 -translate-y-1/2 right-0 rtl:right-auto rtl:left-0 rtl:rotate-180 pl-2 pr-2 pt-2 pb-2 rounded-full z-10 w-7 h-7 after:text-[20px] duration-200 hover:opacity-100 disabled:cursor-not-allowed disabled:hidden transition-all ease-in-out disabled:opacity-30" aria-label="next slide">
                      {% render 'icon-labels-bags', icon: 'chevron-right' %}
                    </button>
                  </div>
                  <div class="splide__track">
                    <div class="splide__list flex items-end pb-0.5">
                    {% assign block_id_downcase = block.id | replace: "_", "" | downcase %}
                    {% assign sub_menu_items = '' %}
                    {%- for link in block.settings.menu.links -%}
                      <div
                        class="h-full sub-menu-horizontal splide__slide x-splide-slide table{% if link.links != blank %} has-dropdown{% endif %}"
                        :class="$store.xHeaderMenu.subShow.get('{{ block_id_downcase }}') === '{{ forloop.index }}' && 'active'"
                        {% if forloop.first %}
                          x-intersect.once="$store.xHeaderMenu.openSubMenu('{{ block_id_downcase }}', '{{ forloop.index }}');"
                        {% endif %}
                        @mouseover="$dispatch('mouseover-{{ block_id_downcase }}-{{ forloop.index }}'); $el.classList.add('is-focus-child')"
                        @mouseleave="$el.classList.remove('is-focus-child');"
                        @focusin="$dispatch('focusin-{{ block_id_downcase }}-{{ forloop.index }}'); $el.classList.add('is-focus-child')"
                        @focusout="$el.classList.remove('is-focus-child');"
                      >
                        <div class="h-full sub-menu flex items-center z-10 relative pl-2.5 pr-2.5 w-[15.6rem]">
                          {% liquid 
                            assign show_image = false
                            if link.type == 'product_link' and block.settings.show_image_product
                              assign show_image = true
                            endif
                            if link.type == 'collection_link' and block.settings.show_image_collection
                              assign show_image = true
                            endif
                          %}
                          {% if show_image %}
                            {%- render 'menu-item-image', link: link, show_first_image_product: block.settings.show_first_image_product, class_ratio: class_image_ratio, image_left: true, collection_metafield: block.settings.collection_metafield -%}
                          {% endif %}
                          <span class="flex-1">
                            <a href="{{ link.url }}"
                              class="nav-link w-full text-left p-break-words z-10 pb-3 pt-3 flex flex-wrap gap-2 items-center{% if link.links != blank %} pr-5 rtl:pr-0 rtl:pl-5{% endif %} hover-text-link is-focus-child:effect-inline{%- if link.current or link.child_active %} flex effect-inline{% endif %}"
                              {% if link.links != blank %}@init-run.window="$store.xHeaderMenu.isTouch && $store.xHeaderMenu.touchItem($el, true, {{ forloop.index }})"{% endif %}
                            >
                              {% liquid
                                assign is_labeled = false
                                assign menu_item = '||' | append: link.title | append: '||' | escape
                                if list_sub_menu contains menu_item
                                  assign is_labeled = true
                                endif
                              %}
                              {% assign title = link.title %}
                              {% if section.settings.enable_highlight %}
                                {% liquid
                                  assign is_highlight = false
                                  assign menu_item = '||' | append: title | append: '||' | escape
                                  if list_menu contains menu_item
                                    assign is_highlight = true
                                  endif
                                %}
                                {% if is_highlight %}
                                  {% render 'menu-highlight',
                                    highlight_type: section.settings.highlight_style,
                                    menu_title: title,
                                    section_id: section.id,
                                  %}
                                {% else %}
                                  <span class="p-break-words">{{ title | escape }}</span>
                                {% endif %}
                              {% else %}
                                <span class="p-break-words">{{ title | escape }}</span>
                              {% endif %}
                              {% if is_labeled %}
                                {{ sub_label }}
                              {% endif %}
                            </a>
                          </span>
                        </div>
                      </div>
                      {% capture sub_menu_item %}
                        <li
                          class="sub-menu-item {% if link.links != blank %} has-dropdown{% endif %} max-h-full w-full overflow-y-auto scrollbar-body scrollbar-visible"
                          :class="$store.xHeaderMenu.subShow.get('{{ block_id_downcase }}') === '{{ forloop.index }}' && 'is-active'"
                          @mouseover-{{ block_id_downcase }}-{{ forloop.index }}.window="$el.classList.add('is-focus-child'); $store.xHeaderMenu.openSubMenu('{{ block_id_downcase }}', '{{ forloop.index }}');"
                          @mouseleave="$el.classList.remove('is-focus-child');"
