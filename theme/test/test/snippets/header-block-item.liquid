                  --colors-button-text-hover: {{ block.settings.color_text_button_hover_dark_quick_access.red }}, {{ block.settings.color_text_button_hover_dark_quick_access.green }}, {{ block.settings.color_text_button_hover_dark_quick_access.blue }};
                {% else %}  
                  --colors-button-text-hover: {{ settings.colors_dark_button_text_hover.red }}, {{ settings.colors_dark_button_text_hover.green }}, {{ settings.colors_dark_button_text_hover.blue }};
