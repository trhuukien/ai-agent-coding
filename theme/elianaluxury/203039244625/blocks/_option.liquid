{%- liquid
  assign heading_size = block.settings.heading_size | times: settings.heading_base_size | times: 0.000225
  assign text_size = block.settings.text_size | times: settings.text_base_size | times: 0.0000875
-%}
{%- style -%}
  .heading-{{ block.id }} {
    font-size: {{ heading_size | times: 0.6 }}rem;
  }
  .text-{{ block.id }} {
    font-size: {{ text_size | times: 0.9 }}rem;
  }
  @media screen and (min-width: 768px) {
    .heading-{{ block.id }} { font-size: {{ heading_size }}rem; }
    .text-{{ block.id }} { font-size: {{ text_size }}rem; }
  }
  .size-icon-{{ block.id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }
  .icon-color-{{ block.id }} {
    {% if block.settings.icon_color_light.alpha != 0.0 %}
      color: rgb({{ block.settings.icon_color_light.red }},{{ block.settings.icon_color_light.green }},{{ block.settings.icon_color_light.blue }});
    {% else %}
      color: rgb(var(--colors-text));
    {% endif %}
  }
  .dark .icon-color-{{ block.id }} {
    {% if block.settings.icon_color_dark.alpha != 0.0 %}
      color: rgb({{ block.settings.icon_color_dark.red }},{{ block.settings.icon_color_dark.green }},{{ block.settings.icon_color_dark.blue }});
    {% else %}
      color: rgb(var(--colors-text));
    {% endif %}
  }
  {% if block.settings.icon_position == 'next' %}
    .quiz-option.quiz-option-{{ block.id }} .quiz-option__inner {
      align-items: center;
    }
  {% endif %}
{%- endstyle -%}
{% liquid
  assign strong_match = block.settings.strong_match | where: 'available'
  assign partial_match = block.settings.partial_match | where: 'available'
  assign exclude_product = block.settings.exclude_product | where: 'available'
  if settings.gift_wrapping_product != blank and settings.hide_gift_wrapping
    assign strong_match = strong_match | reject: 'id', settings.gift_wrapping_product.id
    assign partial_match = partial_match | reject: 'id', settings.gift_wrapping_product.id
    assign exclude_product = exclude_product | reject: 'id', settings.gift_wrapping_product.id
  endif
  if settings.engraving_product != blank
    assign strong_match = strong_match | reject: 'id', settings.engraving_product.id
    assign partial_match = partial_match | reject: 'id', settings.engraving_product.id
    assign exclude_product = exclude_product | reject: 'id', settings.engraving_product.id
  endif
  if settings.product_shipping_insurance != blank
    assign strong_match = strong_match | reject: 'id', settings.product_shipping_insurance.id
    assign partial_match = partial_match | reject: 'id', settings.product_shipping_insurance.id
    assign exclude_product = exclude_product | reject: 'id', settings.product_shipping_insurance.id
  endif

  assign strong_match_ids = strong_match | map: 'id' | join: ','
  assign partial_match_ids = partial_match | map: 'id' | join: ','
  assign exclude_product_ids = exclude_product | map: 'id' | join: ','
%}
<div
  x-show="qId === currentQuestionId"
  x-cloak
  x-transition:enter="transition-opacity duration-500 ease-in-out"
  x-transition:enter-start="opacity-10"
  x-transition:enter-end="opacity-100"
  @click="selectAnswer(qId, {2:[{{ strong_match_ids }}], 1:[{{ partial_match_ids }}], 0:[{{ exclude_product_ids }}], 'id':['{{ block.id }}']}, '{{ block.settings.skip_questions }}', '{{ block.id }}')"
  class="quiz-option quiz-option-{{ block.id }} w-full h-full cursor-pointer"
  {{ block.shopify_attributes }}
>
  <div
    class="quiz-option__inner h-full flex {% if block.settings.icon_position == 'above' %}flex-col{% endif %} gap-3 pt-3 pb-3 pl-5 pr-5 md:pt-5 md:pb-5 md:pl-7 md:pr-7 border border-[rgb(var(--colors-line-and-border))]{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}"
    :class="{ 'bg-[rgba(var(--colors-line-and-border))] selected': hasAnswer(qId, {2:[{{ strong_match_ids }}], 1:[{{ partial_match_ids }}], 0:[{{ exclude_product_ids }}], 'id':['{{ block.id }}']}) }"
  >
    {%- unless block.settings.icon == 'none' -%}
      {% unless block.settings.custom_icon == blank
        and block.settings.another_icon == blank
        and block.settings.icon == 'another_icon'
        and block.settings.custom_image == blank
      %}
        <span class="inline-flex flex-shrink-0 size-icon-{{ block.id }} icon-color-{{ block.id }}">
          {% if block.settings.custom_image != blank %}
            {% # theme-check-disable ImgLazyLoading %}
            <img
              src="{{ block.settings.custom_image | image_url: width: block.settings.icon_size }}"
              alt="{{ block.settings.custom_image.alt | escape }}"
              {% if settings.enable_lazy_loading_image %}
                loading="lazy"
              {% else %}
                loading="eager"
              {% endif %}
              width="{{ block.settings.custom_image.width }}"
              height="{{ block.settings.custom_image.height }}"
              class="object-cover size-icon-{{ block.id }}"
            >
            {% # theme-check-enable ImgLazyLoading %}
          {% elsif block.settings.custom_icon != blank %}
            {{ block.settings.custom_icon }}
          {% elsif block.settings.another_icon != blank and block.settings.icon == 'another_icon' %}
            {% render 'icon-new-alls', icon: block.settings.another_icon %}
          {% else %}
            {% render 'icon-labels-bags', icon: block.settings.icon %}
          {% endif %}
        </span>
      {% endunless %}
    {%- endunless -%}
    <div class="text-{{ block.id }} min-w-0">
      {%- if block.settings.title != blank -%}
        <span id="option-heading-{{ block.id }}" class="hidden">{{ block.settings.title }}</span>
        <p class="h4 leading-tight heading-{{ block.id }} text-[rgba(var(--colors-heading))]">
          {% render 'heading-highlight',
            headingId: block.id,
            heading: block.settings.title,
            highlight_type: block.settings.highlight_type
          %}
        </p>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <div id="option-description-{{ block.id }}" class="rte mt-1 text-[rgb(var(--colors-text))]">
          {{ block.settings.text }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
